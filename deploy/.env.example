# Copy to deploy/.env and adjust before running live_infra.

# PostgreSQL connection (matches deploy/docker-compose.yml defaults)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=keronis
DB_USER=keronis
DB_PASSWORD=keronis_dev

# Local market-data / cache root directory
DATA_DIR_ROOT=/tmp/keronis_data

# Venue API credentials file (copy deploy/accounts.example.json -> deploy/accounts.json)
ACCOUNTS_FILE=./deploy/accounts.json

# Messaging bus (NATS_TOKEN is required by live_infra)
NATS_URL=nats://127.0.0.1:4222
NATS_TOKEN=keronis_dev_nats_token

# Safety & runtime switches
# Note: setting IS_PROD=1 enables quote_guard enforcement on non-paper
# strategies (requires a fresh quote_guard heartbeat in engine_health
# where engine_instance = 'quote_guard').
# Leave IS_PROD unset or 0 for local paper development.
IS_PROD=0
# Set to 1 to block all live order submissions while testing feeds & strategies
IS_ORDER_CREATION_DISABLED=1
PAPER_SLIPPAGE_BPS=3

# Direct venue signing (enabled by default in C++; set *_USE_TESTNET=1 for testnet)
HYPERLIQUID_DIRECT_SIGNING=1
HYPERLIQUID_USE_TESTNET=1
ASTER_DIRECT_SIGNING=1
ASTER_USE_TESTNET=1
POLYMARKET_DIRECT_SIGNING=1

# HTTP introspection & control server (bound to localhost by default)
ENABLE_ENGINE_CONTROL_SERVER=1
ENGINE_CONTROL_SERVER_BIND=127.0.0.1
ENGINE_CONTROL_SERVER_PORT=8090
ENABLE_ENGINE_CONTROL_MUTATIONS=0
