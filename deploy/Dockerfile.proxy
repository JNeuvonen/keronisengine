FROM python:3.12-slim

WORKDIR /app

COPY src/py/cpp_live_proxy /app/cpp_live_proxy
RUN pip install --no-cache-dir -r /app/cpp_live_proxy/cpp_live_proxy/requirements.txt \
    && pip install --no-cache-dir --no-deps /app/cpp_live_proxy

ENV HOST=0.0.0.0
ENV PORT=8000
EXPOSE 8000

CMD ["uvicorn", "cpp_live_proxy.main:app", "--host", "0.0.0.0", "--port", "8000"]
