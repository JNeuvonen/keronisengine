        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .backdrop {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image:
          radial-gradient(ellipse 75% 45% at 50% -8%, rgba(34, 211, 238, 0.13), transparent 70%),
          radial-gradient(ellipse 40% 35% at 85% 18%, rgba(52, 211, 153, 0.07), transparent 65%),
          radial-gradient(rgba(148, 163, 184, 0.1) 1px, transparent 1px);
        background-size: 100% 100%, 100% 100%, 28px 28px;
      }

      .wrap {
        position: relative;
        z-index: 1;
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(14px);
        background: rgba(7, 9, 14, 0.8);
        border-bottom: 1px solid var(--border);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
        gap: 1rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 700;
        font-size: 1.02rem;
        letter-spacing: -0.02em;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.4rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .nav-gh {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.42rem 0.8rem;
        border-radius: 0.45rem;
        border: 1px solid var(--border-bright);
        color: var(--text) !important;
        font-size: 0.85rem;
        font-weight: 500;
        background: rgba(255, 255, 255, 0.02);
      }

      .nav-gh:hover {
        border-color: var(--cyan);
      }

      .hero {
        padding: clamp(3.2rem, 7vw, 5.8rem) 0 2.6rem;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.76rem;
        color: var(--cyan);
        background: var(--cyan-soft);
        border: 1px solid rgba(34, 211, 238, 0.28);
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        margin-bottom: 1.35rem;
      }

      .eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--emerald);
        box-shadow: 0 0 10px var(--emerald);
      }

      h1 {
        font-size: clamp(2.35rem, 5.2vw, 4rem);
        line-height: 1.05;
        letter-spacing: -0.035em;
        font-weight: 800;
        margin: 0 0 1.2rem;
        max-width: 17ch;
      }

      .grad {
        background: linear-gradient(110deg, #f8fafc 15%, #67e8f9 65%, #34d399 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

