---
import { Code } from '@astrojs/starlight/components';

const title = 'KeronisEngine — Sub-ms Trading Engine for High-Performance Predictive Models';
const description =
  'Open-source C++20 trading engine engineered for high-performance predictive models and any algorithmic strategy. Trade crypto, Polymarket, US equities (IBKR), and event or sports markets from one system.';

const codePolymarketDigital = `// src/cpp/packages/strategies/polymarket_digital/polymarket_digital.cpp
// Polymarket digital options market making / high-frequency pricer:
// Prices P(S_T > K) from live Binance spot (swap fair_prob_yes with OnnxModel::predict)
// and quotes/executes YES or NO on the Polymarket CLOB when edge exceeds threshold.
double fair_prob_yes(double spot, double strike, double tau_sec) {
    const double denom = kAnnualVol * std::sqrt(tau_sec / kSecondsPerYear);
    if (denom <= 1e-9) return spot >= strike ? 1.0 : 0.0;
    return std::clamp(normal_cdf(std::log(spot / strike) / denom), 0.01, 0.99);
}

std::vector<Core::StrategyDecision> on_market_event(
    Core::Engine& engine, Core::Strategy& strategy,
    std::optional<Core::MarketEvent>) {
    std::vector<Core::StrategyDecision> decisions;
    const long long now_ms = engine.get_time();

    auto tickers_lock = strategy.lock_on_pred_market_strat();
    for (auto& [symbol, ticker] : strategy.trade_tickers) {
        std::lock_guard<std::mutex> lock(ticker->trading_mutex);
        if (ticker->clob_ids_by_index.size() < 2 || !ticker->get_orders(false).empty()) continue;

        const long long remaining_ms = ticker->event_end_time_ms.load() - now_ms;
        const auto spot = engine.get_price(ticker->underlying_symbol, "binance", "swap");
        if (remaining_ms < kMinRemainingMs || !spot || *spot <= 0.0) continue;

        const double p_yes = fair_prob_yes(*spot, ticker->strike_price, remaining_ms / 1000.0);
        const double fair[2] = {p_yes, 1.0 - p_yes};
        const double tick = ticker->order_price_min_tick_size.load();

        Core::StrategyDecision decision;
        decision.symbol = symbol;
        for (int outcome = 0; outcome < 2; ++outcome) {
            if (ticker->get_outcome_exchange_inventory(outcome) >= kMaxOutcomePos) continue;
            const auto bba = ticker->read_outcome_bba(outcome);
            if (!bba || bba->best_ask <= 0.0 || (fair[outcome] - bba->best_ask) < kMinEdge) continue;

            auto [res, order] = ticker->construct_order(engine, strategy, make_limit_buy(
                symbol, round_to_tick(bba->best_ask, tick), kOrderShares, now_ms, *ticker, strategy));
            if (res == Core::OrderConstructionResult::VALID && order.has_value()) {
                auto o = order.value();
                o.is_prediction_market_order = true;
                o.clob_id = ticker->clob_ids_by_index[outcome];
                o.outcome_name = outcome == 0 ? "Yes" : "No";
                ticker->mark_order_to_be_created(engine, o, decision, strategy);
                break;
            }
        }
        if (!decision.orders.empty()) decisions.push_back(std::move(decision));
    }
    return decisions;
}

KERONIS_REGISTER_STRATEGY("polymarket_digital", bind_polymarket_digital);`;

const codeBinanceOnnx = `// src/cpp/packages/strategies/binance_onnx_perp/binance_onnx_perp.cpp
// Predictive-model perpetuals strategy:
// Streaming taker-flow features -> in-process ONNX inference -> risk-checked execution.
void compute_predictions(Core::Engine& engine, Core::Strategy& strategy) {
    auto sm = MarketData::StateMachineDispatcher::get_instance().get_machine(
        "windowed_taker_flow");
    auto features = sm ? sm->emit_state() : std::nullopt;
    if (!features || features->empty()) return;

    float score = 0.5f;
    if (!strategy.strategy_config.strategy_models.empty()) {
        auto model = get_or_load_model(
            strategy.strategy_config.strategy_models.front().path_to_model);
        if (model && features->size() == model->get_input_size()) {
            score = model->predict(*features);
        }
    }

    const long long now_ms = engine.get_time();
    for (auto& [symbol, ticker] : strategy.trade_tickers) {
        ticker->atomic_signal_main.store(score, now_ms);
    }
}

std::vector<Core::StrategyDecision> on_market_event(
    Core::Engine& engine, Core::Strategy& strategy,
    std::optional<Core::MarketEvent>) {
    std::vector<Core::StrategyDecision> decisions;
    for (auto& [symbol, ticker] : strategy.trade_tickers) {
        std::lock_guard<std::mutex> lock(ticker->trading_mutex);
        if (!ticker->get_orders(false).empty() || ticker->exchange_and_markets.empty()) continue;

        const auto [score, signal_ts] = ticker->atomic_signal_main.load();
        if (signal_ts <= 0) continue;

        const auto& em = ticker->exchange_and_markets.front();
        const auto price = engine.get_price(symbol, em.exchange_name, em.market_type);
        if (!price || *price <= 0.0) continue;

        Core::StrategyDecision decision;
        decision.symbol = symbol;
        const auto trades = ticker->get_trades(false);
        if (trades.empty() && score > kEnterThreshold) {
            Core::StrategyHelpers::submit_market_order(
                engine, strategy, *ticker, Core::OrderSide::BUY, *price,
                mpfr::mpreal(kOrderQty), decision);
        } else if (!trades.empty() && score < kExitThreshold) {
            Core::StrategyHelpers::close_trade_market(
                engine, strategy, *ticker, trades.front(), *price, decision);
        }
        if (!decision.orders.empty()) decisions.push_back(std::move(decision));
    }
    return decisions;
}

KERONIS_REGISTER_STRATEGY("binance_onnx_perp", bind_binance_onnx_perp);`;

const codeSpreadSm = `// src/cpp/packages/historical_feature_gen/src/transformations/spread_sm.cpp
// Streaming feature template: runs identically in offline Parquet training panels,
// historical backtests, paper trading, and live execution.
void SpreadSM::react_impl(const MarketData::MarketEvent& event) {
    if (event.type != MarketData::MarketEvent::BBA || !event.bba.has_value()) return;
    auto it = symbol_states_.find(event.symbol_key());
    if (it == symbol_states_.end()) return;

    const double bid = event.bba->bid_price;
    const double ask = event.bba->ask_price;
    if (bid <= 0.0 || ask <= 0.0 || ask < bid) return;

    it->second.last_bid = bid;
    it->second.last_ask = ask;
    it->second.has_bba = true;
}

std::optional<std::vector<float>> SpreadSM::emit_state_impl() const {
    if (symbol_states_.empty()) return std::nullopt;
    std::vector<float> result;
    result.reserve(symbol_states_.size());
    for (const auto& [key, state] : symbol_states_) {
        if (!state.has_bba) return std::nullopt;
        result.push_back(static_cast<float>(state.last_ask - state.last_bid));
    }
    return result;
}

KERONIS_REGISTER_STATE_MACHINE("spread", SpreadSM);`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #05070c;
        --bg-surface: #0a0e17;
        --bg-card: #0d121e;
        --border: rgba(148, 163, 184, 0.12);
        --border-bright: rgba(148, 163, 184, 0.24);
        --text: #f1f5f9;
        --text-muted: #94a3b8;
        --text-dim: #64748b;
        --cyan: #22d3ee;
        --cyan-soft: rgba(34, 211, 238, 0.12);
        --emerald: #34d399;
        --emerald-soft: rgba(52, 211, 153, 0.12);
        --amber: #fbbf24;
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* Ambient Nautilus-inspired lighting + subtle grid */
      .ambient {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }

      .ambient-grid {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(148, 163, 184, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(148, 163, 184, 0.035) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 10%, #000 30%, transparent 100%);
      }

      .orb {
        position: absolute;
        border-radius: 999px;
        filter: blur(95px);
        opacity: 0.42;
        will-change: transform;
      }

      .orb-1 {
        width: 620px;
        height: 420px;
        top: -160px;
        left: calc(50% - 310px);
        background: radial-gradient(circle, rgba(34, 211, 238, 0.42), rgba(14, 165, 233, 0.08) 65%, transparent 100%);
      }

      .orb-2 {
        width: 480px;
        height: 360px;
        top: 180px;
        right: -120px;
        background: radial-gradient(circle, rgba(52, 211, 153, 0.24), transparent 70%);
      }

      @media (prefers-reduced-motion: no-preference) {
        .orb-1 {
          animation: orbFloat 18s ease-in-out infinite alternate;
        }
        .orb-2 {
          animation: orbFloatAlt 22s ease-in-out infinite alternate;
        }
      }

      @keyframes orbFloat {
        0% {
          transform: translate3d(-24px, 0, 0) scale(1);
        }
        100% {
          transform: translate3d(28px, 18px, 0) scale(1.06);
        }
      }

      @keyframes orbFloatAlt {
        0% {
          transform: translate3d(0, 0, 0) scale(1);
        }
        100% {
          transform: translate3d(-32px, 24px, 0) scale(1.08);
        }
      }

      .wrap {
        position: relative;
        z-index: 1;
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Header */
      header {
        position: sticky;
        top: 0;
        z-index: 30;
        backdrop-filter: blur(16px);
        background: rgba(5, 7, 12, 0.72);
        border-bottom: 1px solid var(--border);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
        gap: 1rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: -0.02em;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        font-size: 0.88rem;
        color: var(--text-muted);
      }

      .nav-links a {
        transition: color 0.15s ease;
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .nav-gh {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
        border: 1px solid var(--border-bright);
        color: var(--text) !important;
        font-size: 0.84rem;
        font-weight: 500;
        background: rgba(255, 255, 255, 0.03);
      }

      .nav-gh:hover {
        border-color: var(--cyan);
      }

      /* Centered Hero */
      .hero {
        text-align: center;
        padding: clamp(4.2rem, 9vw, 7rem) 0 3.5rem;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: #a5f3fc;
        background: rgba(34, 211, 238, 0.08);
        border: 1px solid rgba(34, 211, 238, 0.25);
        padding: 0.34rem 0.85rem;
        border-radius: 999px;
        margin-bottom: 1.6rem;
      }

      .eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--emerald);
        box-shadow: 0 0 10px var(--emerald);
      }

      h1 {
        font-size: clamp(2.5rem, 6vw, 4.4rem);
        line-height: 1.04;
        letter-spacing: -0.04em;
        font-weight: 800;
        margin: 0 auto 1.35rem;
        max-width: 17ch;
      }

      .grad {
        background: linear-gradient(110deg, #ffffff 10%, #67e8f9 55%, #34d399 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .lead {
        font-size: clamp(1.02rem, 1.45vw, 1.18rem);
        color: var(--text-muted);
        max-width: 64ch;
        margin: 0 auto 2.1rem;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.8rem;
        margin-bottom: 1.65rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.78rem 1.45rem;
        border-radius: 999px;
        font-size: 0.92rem;
        font-weight: 600;
        transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-primary {
        background: linear-gradient(135deg, #22d3ee, #34d399);
        color: #041218;
        box-shadow: 0 0 28px rgba(34, 211, 238, 0.24);
      }

      .btn-secondary {
        background: rgba(13, 18, 30, 0.85);
        border: 1px solid var(--border-bright);
        color: var(--text);
      }

      .btn-secondary:hover {
        border-color: var(--cyan);
      }

      .cmd-bar {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        max-width: 100%;
        padding: 0.6rem 0.95rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: rgba(10, 14, 23, 0.85);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: #cbd5e1;
        overflow-x: auto;
      }

      .cmd-bar .prompt {
        color: var(--emerald);
        user-select: none;
      }

      .copy-btn {
        background: transparent;
        border: 1px solid var(--border-bright);
        color: var(--text-muted);
        border-radius: 999px;
        padding: 0.22rem 0.65rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        cursor: pointer;
        flex-shrink: 0;
      }

      .copy-btn:hover {
        color: var(--text);
        border-color: var(--cyan);
      }

      /* Hairline stat bar */
      .stat-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        margin: 3.2rem 0 0;
        text-align: left;
      }

      .stat {
        padding: 1.35rem 1.25rem;
        border-right: 1px solid var(--border);
      }

      .stat:last-child {
        border-right: none;
      }

      .stat-val {
        font-family: var(--font-mono);
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
      }

      .stat-val span {
        color: var(--cyan);
      }

      .stat-lbl {
        margin-top: 0.3rem;
        font-size: 0.82rem;
        color: var(--text-muted);
        line-height: 1.45;
      }

      /* Sections */
      section {
        margin-bottom: 5.5rem;
      }

      .sec-head {
        margin-bottom: 1.9rem;
      }

      .sec-kicker {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--cyan);
        margin-bottom: 0.5rem;
      }

      h2 {
        font-size: clamp(1.65rem, 3.1vw, 2.35rem);
        letter-spacing: -0.03em;
        margin: 0 0 0.7rem;
        line-height: 1.15;
      }

      .sec-desc {
        color: var(--text-muted);
        max-width: 68ch;
        margin: 0;
        font-size: 0.98rem;
      }

      /* Interactive Animated Architecture Stage */
      .stage-shell {
        border-radius: 1rem;
        border: 1px solid var(--border-bright);
        background:
          radial-gradient(ellipse 60% 45% at 50% 0%, rgba(34, 211, 238, 0.08), transparent 70%),
          linear-gradient(180deg, rgba(11, 16, 27, 0.96), rgba(6, 9, 16, 0.98));
        overflow: hidden;
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
      }

      .stage-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.75rem 1.1rem;
        border-bottom: 1px solid var(--border);
        background: rgba(9, 13, 22, 0.9);
      }

      .seg-tabs {
        display: inline-flex;
        gap: 0.3rem;
        background: rgba(15, 23, 42, 0.7);
        padding: 0.25rem;
        border-radius: 999px;
        border: 1px solid var(--border);
      }

      .seg-tab {
        appearance: none;
        border: none;
        background: transparent;
        color: var(--text-muted);
        font-family: var(--font-sans);
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.42rem 0.95rem;
        border-radius: 999px;
        cursor: pointer;
        transition: color 0.15s ease, background 0.15s ease;
      }

      .seg-tab[aria-selected='true'] {
        background: rgba(34, 211, 238, 0.15);
        color: var(--cyan);
      }

      .seg-tab:focus-visible,
      .pause-btn:focus-visible,
      .asset-tab:focus-visible,
      .code-tab:focus-visible {
        outline: 2px solid var(--cyan);
        outline-offset: 2px;
      }

      .pause-btn {
        appearance: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: transparent;
        border: 1px solid var(--border-bright);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.74rem;
        padding: 0.36rem 0.78rem;
        border-radius: 999px;
        cursor: pointer;
      }

      .pause-btn:hover {
        color: var(--text);
        border-color: var(--cyan);
      }

      .stage-view {
        display: none;
        padding: 1.4rem 1.25rem 1.2rem;
        overflow-x: auto;
      }

      .stage-view.active {
        display: block;
      }

      .stage-view svg {
        display: block;
        width: 100%;
        min-width: 760px;
        height: auto;
      }

      /* Animated circuit traces */
      .trace-flow {
        stroke-dasharray: 8 10;
      }

      .trace-flow-slow {
        stroke-dasharray: 6 12;
      }

      .pulse-ring {
        transform-box: fill-box;
        transform-origin: center;
      }

      @media (prefers-reduced-motion: no-preference) {
        .stage-shell:not(.is-paused) .trace-flow {
          animation: flowDash 1.15s linear infinite;
        }
        .stage-shell:not(.is-paused) .trace-flow-slow {
          animation: flowDash 2.1s linear infinite;
        }
        .stage-shell:not(.is-paused) .pulse-ring {
          animation: nodePulse 2.8s ease-in-out infinite;
        }
      }

      @keyframes flowDash {
        from {
          stroke-dashoffset: 36;
        }
        to {
          stroke-dashoffset: 0;
        }
      }

      @keyframes nodePulse {
        0%,
        100% {
          opacity: 0.28;
          transform: scale(1);
        }
        50% {
          opacity: 0.75;
          transform: scale(1.03);
        }
      }

      .stage-caption {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.85rem 1.25rem;
        border-top: 1px solid var(--border);
        background: rgba(8, 11, 18, 0.85);
        font-size: 0.83rem;
        color: var(--text-muted);
      }

      .stage-caption strong {
        color: var(--text);
      }

      /* Interactive Multi-Asset Switcher */
      .asset-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
      }

      .asset-tab {
        appearance: none;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--text-muted);
        font-family: var(--font-sans);
        font-size: 0.86rem;
        font-weight: 600;
        padding: 0.58rem 1.05rem;
        border-radius: 999px;
        cursor: pointer;
        transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
      }

      .asset-tab:hover {
        border-color: var(--border-bright);
        color: var(--text);
      }

      .asset-tab[aria-selected='true'] {
        background: var(--cyan-soft);
        border-color: rgba(34, 211, 238, 0.42);
        color: var(--cyan);
      }

      .asset-panel {
        display: none;
        grid-template-columns: 1.05fr 1fr;
        gap: 1.5rem;
        padding: 1.75rem;
        border-radius: 1rem;
        border: 1px solid var(--border-bright);
        background: linear-gradient(180deg, rgba(13, 18, 30, 0.92), rgba(8, 11, 18, 0.96));
        align-items: center;
      }

      .asset-panel.active {
        display: grid;
      }

      .asset-copy h3 {
        margin: 0 0 0.65rem;
        font-size: 1.35rem;
        letter-spacing: -0.02em;
      }

      .asset-copy p {
        margin: 0 0 1.15rem;
        color: var(--text-muted);
        font-size: 0.94rem;
      }

      .venue-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 1.25rem;
      }

      .vpill {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        padding: 0.25rem 0.6rem;
        border-radius: 0.4rem;
        border: 1px solid var(--border-bright);
        background: rgba(15, 23, 42, 0.65);
        color: #cbd5e1;
      }

      .vpill.hi {
        border-color: rgba(52, 211, 153, 0.4);
        color: var(--emerald);
        background: var(--emerald-soft);
      }

      .asset-link {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--cyan);
      }

      .asset-link:hover {
        text-decoration: underline;
      }

      /* Terminal preview card on right side of asset panel */
      .sim-card {
        border-radius: 0.75rem;
        border: 1px solid var(--border-bright);
        background: #070a12;
        overflow: hidden;
        font-family: var(--font-mono);
        font-size: 0.78rem;
      }

      .sim-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 0.9rem;
        border-bottom: 1px solid var(--border);
        background: #0c111d;
        color: var(--text-muted);
      }

      .sim-badge {
        color: var(--emerald);
        font-size: 0.72rem;
      }

      .sim-body {
        padding: 0.95rem 1rem;
        display: grid;
        gap: 0.55rem;
      }

      .sim-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        color: var(--text-muted);
      }

      .sim-row strong {
        color: var(--text);
        font-weight: 600;
      }

      .sim-row .pos {
        color: var(--emerald);
      }

      .sim-row .cy {
        color: var(--cyan);
      }

      .sim-row .am {
        color: var(--amber);
      }

      .sim-divider {
        height: 1px;
        background: var(--border);
        margin: 0.25rem 0;
      }

      .sim-action {
        padding: 0.55rem 0.75rem;
        border-radius: 0.45rem;
        background: rgba(52, 211, 153, 0.08);
        border: 1px solid rgba(52, 211, 153, 0.28);
        color: #a7f3d0;
        font-size: 0.76rem;
      }

      /* Syntax-highlighted code viewer */
      .code-shell {
        border-radius: 0.9rem;
        border: 1px solid var(--border-bright);
        background: #0d1117;
        overflow: hidden;
      }

      .code-tablist {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        padding: 0.6rem 0.85rem;
        background: #0a0e16;
        border-bottom: 1px solid var(--border);
      }

      .code-tab {
        appearance: none;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        padding: 0.45rem 0.85rem;
        border-radius: 0.45rem;
        cursor: pointer;
      }

      .code-tab[aria-selected='true'] {
        background: var(--cyan-soft);
        border-color: rgba(34, 211, 238, 0.34);
        color: var(--cyan);
      }

      .code-panel {
        display: none;
      }

      .code-panel.active {
        display: block;
      }

      .code-panel :global(pre) {
        margin: 0 !important;
        padding: 1.25rem 1.4rem !important;
        background: #0d1117 !important;
        font-family: var(--font-mono) !important;
        font-size: 0.8rem !important;
        line-height: 1.62 !important;
        overflow-x: auto;
      }

      .code-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.8rem 1.25rem;
        background: #0a0e16;
        border-top: 1px solid var(--border);
        font-size: 0.82rem;
        color: var(--text-muted);
      }

      .code-foot code {
        font-family: var(--font-mono);
        color: var(--emerald);
      }

      .code-foot a {
        color: var(--cyan);
        font-weight: 600;
      }

      /* Full stack 3-col */
      .stack-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
        gap: 1rem;
      }

      .stack-card {
        padding: 1.5rem;
        border-radius: 0.85rem;
        border: 1px solid var(--border);
        background: var(--bg-card);
      }

      .stack-card h3 {
        margin: 0 0 0.5rem;
        font-size: 1.05rem;
      }

      .stack-card p {
        margin: 0;
        font-size: 0.89rem;
        color: var(--text-muted);
      }

      .stack-tag {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--cyan);
        margin-bottom: 0.45rem;
      }

      /* Closing ambient CTA */
      .cta-band {
        position: relative;
        text-align: center;
        padding: 3.4rem 1.75rem;
        border-radius: 1.1rem;
        border: 1px solid var(--border-bright);
        background:
          radial-gradient(ellipse 70% 80% at 50% 100%, rgba(34, 211, 238, 0.16), transparent 70%),
          linear-gradient(180deg, rgba(13, 18, 30, 0.9), rgba(7, 10, 17, 0.98));
        overflow: hidden;
      }

      .cta-band h2 {
        margin-bottom: 0.65rem;
      }

      .cta-band p {
        color: var(--text-muted);
        max-width: 56ch;
        margin: 0 auto 1.75rem;
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 2rem 0 3rem;
        color: var(--text-dim);
        font-size: 0.85rem;
      }

      .foot-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
      }

      .foot-links a:hover {
        color: var(--text);
      }

      @media (max-width: 860px) {
        .stat-strip {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .stat:nth-child(2) {
          border-right: none;
        }
        .stat:nth-child(1),
        .stat:nth-child(2) {
          border-bottom: 1px solid var(--border);
        }
        .asset-panel {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 720px) {
        .nav-links a:not(.nav-gh):not(.nav-docs) {
          display: none;
        }
      }
    </style>
