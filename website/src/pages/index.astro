        border: 1px solid var(--border-bright);
        background: linear-gradient(180deg, rgba(12, 16, 26, 0.96), rgba(8, 11, 18, 0.98));
        padding: 1.25rem;
        overflow-x: auto;
      }

      .diagram-shell svg {
        display: block;
        width: 100%;
        min-width: 740px;
        height: auto;
      }

      /* Flagship examples */
      .examples-grid {
