        appearance: none;
        background: transparent;
        border: 1px solid var(--rule-strong);
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        padding: 0.2rem 0.55rem;
        border-radius: 3px;
        cursor: pointer;
        flex-shrink: 0;
      }

      .copy-btn:hover {
        border-color: var(--accent);
        color: var(--ink);
      }

      /* Prominent, clean quantitative evidence strip */
      .evidence {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        margin: 0 0 5.5rem;
      }

      .ev-item {
        padding: 1.65rem 1.35rem;
        border-right: 1px solid var(--rule);
      }

      .ev-item:last-child {
        border-right: none;
      }

      .ev-num {
        font-family: var(--font-mono);
        font-size: clamp(1.35rem, 2.2vw, 1.7rem);
        font-weight: 600;
        letter-spacing: -0.025em;
        color: var(--ink);
      }

      .ev-num span {
        color: var(--accent);
      }

      .ev-lbl {
        margin-top: 0.35rem;
        font-size: 0.84rem;
        color: var(--ink-2);
      }

      /* Section cadence */
      section.band {
        margin-bottom: 6rem;
      }

      .sec-head {
        margin-bottom: 2rem;
      }

      .kicker {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--accent);
        margin-bottom: 0.5rem;
      }

      h2 {
        font-size: clamp(1.65rem, 3vw, 2.25rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin: 0 0 0.65rem;
      }

      .sec-desc {
        color: var(--ink-2);
        max-width: 62ch;
        margin: 0;
        font-size: 0.98rem;
      }

      /* Animated Technical Architecture Illustration */
      .blueprint {
        border: 1px solid var(--rule-strong);
        border-radius: 6px;
        background:
          radial-gradient(ellipse 65% 45% at 50% 0%, rgba(56, 189, 248, 0.07), transparent 70%),
          var(--bg-inset);
        overflow: hidden;
      }

      .blueprint-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--rule);
        background: var(--bg-panel);
      }

      .seg-tabs {
        display: inline-flex;
        gap: 0.3rem;
      }

      .seg-tab {
        appearance: none;
        border: 1px solid transparent;
        background: transparent;
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.76rem;
        padding: 0.4rem 0.85rem;
        border-radius: 4px;
        cursor: pointer;
      }

      .seg-tab[aria-selected='true'] {
        border-color: rgba(56, 189, 248, 0.45);
        background: var(--accent-soft);
        color: var(--accent);
      }

      .seg-tab:focus-visible,
      .pause-btn:focus-visible,
      .asset-tab:focus-visible,
