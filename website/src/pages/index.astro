        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.76rem 1.4rem;
        border-radius: 4px;
        font-size: 0.92rem;
        font-weight: 500;
        transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
      }

