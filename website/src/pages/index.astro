---
const title = 'KeronisEngine — C++20 Trading Engine Built for Predictive Models';
const description =
  'Open-source C++20 execution and real-time ML inference engine. Sub-millisecond tick-to-ONNX-to-order execution for crypto, Polymarket, and event markets on a single $100 server.';

const codeStrategy = `#include "market_data/state_machine_dispatcher.h"
#include "market_making/strategy_helpers.h"
#include "market_making/strategy_registry.h"
#include "onnx_model.h"

namespace {
OnnxModel& model() {
    static OnnxModel instance("model.onnx");
    return instance;
}

std::vector<Core::StrategyDecision> on_market_event(
    Core::Engine& engine, Core::Strategy& strategy,
    std::optional<Core::MarketEvent>) {
    auto sm = MarketData::StateMachineDispatcher::get_instance().get_machine("taker_flow");
    auto features = sm ? sm->emit_state() : std::nullopt;
    if (!features) return {};

    const float score = model().predict(*features);
    std::vector<Core::StrategyDecision> decisions;

    for (auto& [symbol, ticker] : strategy.trade_tickers) {
        std::lock_guard<std::mutex> lock(ticker->trading_mutex);
        const auto& em = ticker->exchange_and_markets.front();
        const auto price = engine.get_price(symbol, em.exchange_name, em.market_type);
        if (!price || !ticker->get_orders(false).empty()) continue;

        Core::StrategyDecision decision;
        decision.symbol = symbol;
        const auto trades = ticker->get_trades(false);
        if (trades.empty() && score > 0.65f) {
            Core::StrategyHelpers::submit_market_order(
                engine, strategy, *ticker, Core::OrderSide::BUY, *price,
                mpfr::mpreal(0.01), decision);
        } else if (!trades.empty() && score < 0.45f) {
            Core::StrategyHelpers::close_trade_market(
                engine, strategy, *ticker, trades.front(), *price, decision);
        }
        if (!decision.orders.empty()) decisions.push_back(std::move(decision));
    }
    return decisions;
}

void bind_ml_strategy(Core::Strategy& strategy) {
    strategy.strategy_callback = on_market_event;
    strategy.compute_predictions_callback = [](Core::Engine&, Core::Strategy&) {};
}
}  // namespace

KERONIS_REGISTER_STRATEGY("ml_taker", bind_ml_strategy);`;

const codeSm = `#include "market_data/state_machine_registry.h"
#include "market_data/strategy_state_machine.h"

namespace {
class MyFeatureSM : public MarketData::StrategyStateMachine {
   public:
    std::string get_name() const override { return "my_features"; }
    std::vector<std::string> feature_names() const override { return {"last_price"}; }
    void initialize_symbol_states() override { last_price_ = 0.0f; }

   protected:
    void react_impl(const MarketData::MarketEvent& event) override {
        if (event.type == MarketData::MarketEvent::Type::TRADE && event.trade) {
            last_price_ = static_cast<float>(event.trade->price);
        }
    }

    std::optional<std::vector<float>> emit_state_impl() const override {
        if (last_price_ <= 0.0f) return std::nullopt;
        return std::vector<float>{last_price_};
    }

   private:
    float last_price_ = 0.0f;
};
}  // namespace

KERONIS_REGISTER_STATE_MACHINE("my_features", MyFeatureSM);`;

const codeBuild = `# Compile your private strategies and state machines into KeronisEngine without forking
export VCPKG_ROOT=/path/to/vcpkg
ORT=$(./scripts/fetch_onnxruntime.sh)

cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \\
  -DCMAKE_TOOLCHAIN_FILE="$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake" \\
  -DONNXRUNTIME_ROOT="$ORT" \\
  -DKERONIS_STRATEGY_DIRS="/path/to/my_strategies;/path/to/my_state_machines"

cmake --build build -j"$(nproc)"
./build/bin/trading_engine_tests`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #07090e;
        --bg-elevated: #0c1018;
        --bg-card: #0e131e;
        --border: #1b2434;
        --border-bright: #28364d;
        --text: #eef2f7;
        --text-muted: #94a3b8;
        --text-dim: #64748b;
        --cyan: #22d3ee;
        --cyan-soft: rgba(34, 211, 238, 0.12);
        --emerald: #34d399;
        --emerald-soft: rgba(52, 211, 153, 0.12);
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* Precision grid backdrop */
      .backdrop {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image:
          radial-gradient(ellipse 75% 45% at 50% -8%, rgba(34, 211, 238, 0.13), transparent 70%),
          radial-gradient(ellipse 40% 35% at 85% 18%, rgba(52, 211, 153, 0.07), transparent 65%),
          radial-gradient(rgba(148, 163, 184, 0.11) 1px, transparent 1px);
        background-size: 100% 100%, 100% 100%, 28px 28px;
      }

      .wrap {
        position: relative;
        z-index: 1;
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Topbar */
      header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(14px);
        background: rgba(7, 9, 14, 0.78);
        border-bottom: 1px solid var(--border);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
        gap: 1rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 700;
        font-size: 1.02rem;
        letter-spacing: -0.02em;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.4rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .nav-gh {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.42rem 0.8rem;
        border-radius: 0.45rem;
        border: 1px solid var(--border-bright);
        color: var(--text) !important;
        font-size: 0.85rem;
        font-weight: 500;
        background: rgba(255, 255, 255, 0.02);
      }

      .nav-gh:hover {
        border-color: var(--cyan);
      }

      /* Hero */
      .hero {
        padding: clamp(3.5rem, 8vw, 6.2rem) 0 3.2rem;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.76rem;
        color: var(--cyan);
        background: var(--cyan-soft);
        border: 1px solid rgba(34, 211, 238, 0.28);
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        margin-bottom: 1.4rem;
      }

      .eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--emerald);
        box-shadow: 0 0 10px var(--emerald);
      }

      h1 {
        font-size: clamp(2.35rem, 5.4vw, 4.1rem);
        line-height: 1.04;
        letter-spacing: -0.035em;
        font-weight: 800;
        margin: 0 0 1.25rem;
        max-width: 17ch;
      }

      .grad {
        background: linear-gradient(110deg, #f8fafc 15%, #67e8f9 65%, #34d399 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .lead {
        font-size: clamp(1.03rem, 1.45vw, 1.2rem);
        color: var(--text-muted);
        max-width: 64ch;
        margin: 0 0 2rem;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.6rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.75rem 1.35rem;
        border-radius: 0.5rem;
        font-size: 0.93rem;
        font-weight: 600;
        transition: transform 0.14s ease, border-color 0.14s ease, background 0.14s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-primary {
        background: var(--cyan);
        color: #06131a;
      }

      .btn-secondary {
        background: var(--bg-card);
        border: 1px solid var(--border-bright);
        color: var(--text);
      }

      .btn-secondary:hover {
        border-color: var(--cyan);
      }

      .cmd-bar {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        max-width: 100%;
        padding: 0.65rem 0.95rem;
        border-radius: 0.55rem;
        border: 1px solid var(--border);
        background: var(--bg-elevated);
        font-family: var(--font-mono);
        font-size: 0.82rem;
        color: #cbd5e1;
        overflow-x: auto;
      }

      .cmd-bar .prompt {
        color: var(--emerald);
        user-select: none;
      }

      .copy-btn {
        background: transparent;
        border: 1px solid var(--border-bright);
        color: var(--text-muted);
        border-radius: 0.35rem;
        padding: 0.25rem 0.55rem;
        font-family: var(--font-mono);
        font-size: 0.74rem;
        cursor: pointer;
        flex-shrink: 0;
      }

      .copy-btn:hover {
        color: var(--text);
        border-color: var(--cyan);
      }

      /* Metrics strip */
      .metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.9rem;
        margin: 2.8rem 0 3.5rem;
      }

      .metric {
        padding: 1.15rem 1.25rem;
        border-radius: 0.7rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
      }

      .metric-val {
        font-family: var(--font-mono);
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.02em;
      }

      .metric-val span {
        color: var(--cyan);
      }

      .metric-lbl {
        margin-top: 0.35rem;
        font-size: 0.84rem;
        color: var(--text-muted);
      }

      /* Section headings */
      section {
        margin-bottom: 4.5rem;
      }

      .sec-kicker {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--cyan);
        margin-bottom: 0.45rem;
      }

      h2 {
        font-size: clamp(1.55rem, 2.8vw, 2.15rem);
        letter-spacing: -0.025em;
        margin: 0 0 0.7rem;
        line-height: 1.18;
      }

      .sec-desc {
        color: var(--text-muted);
        max-width: 66ch;
        margin: 0 0 1.8rem;
        font-size: 0.98rem;
      }

      /* Pipeline strip */
      .pipeline {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(195px, 1fr));
        gap: 0.85rem;
      }

      .pipe-step {
        position: relative;
        padding: 1.15rem;
        border-radius: 0.7rem;
        background: linear-gradient(180deg, rgba(16, 22, 35, 0.95), rgba(11, 15, 24, 0.95));
        border: 1px solid var(--border);
      }

      .pipe-num {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--emerald);
        margin-bottom: 0.4rem;
      }

      .pipe-step h3 {
        margin: 0 0 0.35rem;
        font-size: 0.96rem;
        font-weight: 700;
      }

      .pipe-step p {
        margin: 0;
        font-size: 0.83rem;
        color: var(--text-muted);
      }

      /* Differentiator 2-col */
      .diff-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: 1rem;
      }

      .diff-card {
        padding: 1.45rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border);
        background: var(--bg-card);
      }

      .diff-card.accent {
        border-color: rgba(34, 211, 238, 0.35);
        background: linear-gradient(180deg, rgba(8, 30, 42, 0.45), rgba(14, 19, 30, 0.96));
      }

      .diff-card h3 {
        margin: 0 0 0.75rem;
        font-size: 1.05rem;
      }

      .diff-card ul {
        margin: 0;
        padding-left: 1.15rem;
        color: var(--text-muted);
        font-size: 0.9rem;
      }

      .diff-card li + li {
        margin-top: 0.5rem;
      }

      /* Code tabs */
      .code-shell {
        border-radius: 0.75rem;
        border: 1px solid var(--border-bright);
        background: #0a0e16;
        overflow: hidden;
      }

      .tablist {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        padding: 0.55rem 0.75rem;
        background: #0d121d;
        border-bottom: 1px solid var(--border);
      }

      .tab {
        appearance: none;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        padding: 0.45rem 0.85rem;
        border-radius: 0.45rem;
        cursor: pointer;
      }

      .tab[aria-selected='true'] {
        background: var(--cyan-soft);
        border-color: rgba(34, 211, 238, 0.32);
        color: var(--cyan);
      }

      .tabpanel {
        display: none;
        margin: 0;
        padding: 1.25rem 1.4rem;
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: 0.82rem;
        line-height: 1.65;
        color: #dbeafe;
      }

      .tabpanel.active {
        display: block;
      }

      /* Bento cards */
      .bento {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
      }

      .card {
        padding: 1.35rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border);
        background: var(--bg-card);
        transition: border-color 0.15s ease;
      }

      .card:hover {
        border-color: var(--border-bright);
      }

      .card-tag {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--cyan);
        margin-bottom: 0.4rem;
      }

      .card h3 {
        margin: 0 0 0.45rem;
        font-size: 1.02rem;
      }

      .card p {
        margin: 0;
        font-size: 0.88rem;
        color: var(--text-muted);
      }

      /* Scope box */
      .scope-box {
        padding: 1.35rem 1.5rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border-bright);
        background: var(--bg-elevated);
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
        font-size: 0.88rem;
      }

      .scope-box strong {
        display: block;
        margin-bottom: 0.3rem;
        color: var(--text);
      }

      .scope-box p {
        margin: 0;
        color: var(--text-muted);
      }

      /* Footer */
      footer {
        border-top: 1px solid var(--border);
        padding: 2rem 0 3rem;
        color: var(--text-dim);
        font-size: 0.85rem;
      }

      .foot-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
      }

      .foot-links a:hover {
        color: var(--text);
      }

      @media (max-width: 760px) {
        .nav-links a:not(.nav-gh):not(.nav-docs) {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="backdrop" aria-hidden="true"></div>

    <header>
      <div class="wrap nav">
        <a href="/" class="brand">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="28" height="28" fill="none">
            <rect x="2" y="2" width="28" height="28" rx="6" fill="#0b111b" stroke="#22d3ee" stroke-width="1.5" />
            <path d="M10 8v16M10 16l9-8M14.5 12l7.5 12" stroke="#e2e8f0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="22" cy="9.5" r="2" fill="#22d3ee" />
          </svg>
          <span>KeronisEngine</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/quickstart/" class="nav-docs">Docs</a>
          <a href="/strategies/">Strategies</a>
          <a href="/state-machines/">State Machines</a>
          <a href="/architecture/">Architecture</a>
          <a href="/comparison/">Comparison</a>
          <a href="https://github.com/JNeuvonen/keronisengine" class="nav-gh">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <section class="hero">
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Apache-2.0 · C++20 · Sub-ms ONNX Inference
        </div>
        <h1>The trading engine built for <span class="grad">predictive models.</span></h1>
        <p class="lead">
          KeronisEngine trades any strategy, with the hard engineering of predictive modeling built into the core:
          streaming C++ feature state machines, sub-millisecond ONNX Runtime inference from tick arrival,
          and identical code across feature generation, backtesting, paper trading, and live execution.
          Supports crypto, Polymarket, and extends cleanly to sports-betting or any order-book market.
        </p>

        <div class="actions">
          <a href="/quickstart/" class="btn btn-primary">Get Started →</a>
          <a href="/architecture/" class="btn btn-secondary">Read Architecture</a>
          <a href="/comparison/" class="btn btn-secondary">vs. NautilusTrader</a>
        </div>

        <div class="cmd-bar">
          <span class="prompt">$</span>
          <code id="docker-cmd">docker run --rm ghcr.io/jneuvonen/keronisengine:latest trading_engine_tests</code>
          <button type="button" class="copy-btn" id="copy-cmd">Copy</button>
        </div>

        <div class="metrics">
          <div class="metric">
            <div class="metric-val"><span>&lt;1 ms</span> tick-to-order</div>
            <div class="metric-lbl">In-process C++ feature update + ONNX inference + order decision</div>
          </div>
          <div class="metric">
            <div class="metric-val"><span>10,000+</span> msg/s</div>
            <div class="metric-lbl">Full Binance live feeds + continuous scoring on a ~$100 server</div>
          </div>
          <div class="metric">
            <div class="metric-val"><span>~1.5 ns</span> / update</div>
            <div class="metric-lbl"><code>RingBufferBook::apply_bid</code> on Core Ultra 9 285K (strict IEEE-754)</div>
          </div>
          <div class="metric">
            <div class="metric-val"><span>1</span> codebase</div>
            <div class="metric-lbl">Same C++ state machines in training panels, backtest, paper &amp; live</div>
          </div>
        </div>
      </section>

      <section>
        <div class="sec-kicker">Predictive-Model Pipeline</div>
        <h2>From market tick to ONNX score in one process</h2>
        <p class="sec-desc">
          Most engines leave ML pipelines to external Python services—introducing network hops and silent train/serve skew.
          KeronisEngine runs streaming feature computation and ONNX Runtime directly in the C++ execution path.
        </p>
        <div class="pipeline">
          <div class="pipe-step">
            <div class="pipe-num">01 / INGEST</div>
            <h3>Market Data</h3>
            <p>Live WebSockets (crypto, Polymarket CLOB, Lighter L2) or partitioned Parquet files.</p>
          </div>
          <div class="pipe-step">
            <div class="pipe-num">02 / BOOK</div>
            <h3>RingBufferBook</h3>
            <p>Tick-indexed 16-byte POD slots, bitmap + <code>__builtin_ctzll</code> depth walks, lazy mmap pages.</p>
          </div>
          <div class="pipe-step">
            <div class="pipe-num">03 / FEATURES</div>
            <h3>StrategyStateMachine</h3>
            <p>Streaming C++ feature engine shared identically with offline <code>historical_feature_gen</code>.</p>
          </div>
          <div class="pipe-step">
            <div class="pipe-num">04 / SCORE</div>
            <h3>ONNX Runtime</h3>
            <p><code>OnnxModel::predict()</code> scores LightGBM, XGBoost, or PyTorch models in-process.</p>
          </div>
          <div class="pipe-step">
            <div class="pipe-num">05 / EXECUTE</div>
            <h3>Backtest · Paper · Live</h3>
            <p>Risk-checked routing to <code>BacktestState</code>, <code>PaperExchange</code>, or native venue signers.</p>
          </div>
        </div>
      </section>

      <section>
        <div class="sec-kicker">Differentiator</div>
        <h2>Why KeronisEngine vs. general-purpose engines</h2>
        <p class="sec-desc">
          NautilusTrader is a strong general-purpose platform for Python strategies and broad broker catalogs.
          KeronisEngine is purpose-built when predictive models sit in the hot path.
        </p>
        <div class="diff-grid">
          <div class="diff-card accent">
            <h3>KeronisEngine (Predictive-Model Native)</h3>
            <ul>
              <li><strong>Zero train/serve skew by construction:</strong> C++ <code>StrategyStateMachine</code>s generate offline Parquet training panels and serve live inference with the same compiled code.</li>
              <li><strong>Sub-millisecond ONNX in-process:</strong> Score gradient boosters or neural nets directly on tick arrival without IPC or Python GIL overhead.</li>
              <li><strong>Multi-market &amp; prediction-market native:</strong> Built-in Polymarket CLOB execution, multi-outcome tickers, and queue-notional backtesting—trivially extensible to sports-betting exchanges.</li>
              <li><strong>Commodity hardware footprint:</strong> Full Binance live feeds (10k+ msg/s) + continuous predictions on a single ~$100 Linux box.</li>
            </ul>
          </div>
          <div class="diff-card">
            <h3>When to pick NautilusTrader or HftBacktest</h3>
            <ul>
              <li><strong>Pick NautilusTrader</strong> if you want to write strategies in Python and want turnkey adapters across traditional equities, FX, and many crypto brokers out of the box.</li>
              <li><strong>Pick HftBacktest</strong> if your primary research depends on strict L3 order-queue-position simulation on CEX books in Python/Numba.</li>
              <li><strong>Keep your alpha private:</strong> With KeronisEngine, external strategies and state machines compile in via <code>-DKERONIS_STRATEGY_DIRS</code> without forking.</li>
            </ul>
          </div>
        </div>
      </section>

