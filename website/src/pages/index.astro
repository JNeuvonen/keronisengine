<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #06080d;
        --bg-panel: #0b0f17;
        --bg-inset: #080b12;
        --rule: rgba(148, 163, 184, 0.13);
        --rule-strong: rgba(148, 163, 184, 0.25);
        --ink: #f1f5f9;
        --ink-2: #94a3b8;
        --ink-3: #64748b;
        --accent: #38bdf8;
        --accent-soft: rgba(56, 189, 248, 0.11);
        --signal: #34d399;
        --artifact: #eab308;
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.88em;
      }

      /* Restrained atmospheric backdrop — depth without SaaS neon */
      .backdrop {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image:
          radial-gradient(ellipse 70% 42% at 50% -6%, rgba(56, 189, 248, 0.12), transparent 68%),
          linear-gradient(rgba(148, 163, 184, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(148, 163, 184, 0.03) 1px, transparent 1px);
        background-size: 100% 100%, 72px 72px, 72px 72px;
      }

      .wrap {
        position: relative;
        z-index: 1;
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 1.75rem;
      }

      /* Topbar */
      header {
        position: sticky;
        top: 0;
        z-index: 30;
        background: rgba(6, 8, 13, 0.82);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--rule);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 62px;
        gap: 1.25rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 600;
        font-size: 0.98rem;
        letter-spacing: -0.02em;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.6rem;
        font-size: 0.87rem;
        color: var(--ink-2);
      }

      .nav-links a:hover {
        color: var(--ink);
      }

      .nav-gh {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--ink) !important;
        padding: 0.36rem 0.78rem;
        border: 1px solid var(--rule-strong);
        border-radius: 4px;
      }

      .nav-gh:hover {
        border-color: var(--accent);
        color: var(--accent) !important;
      }

      /* Hero — monumental, calm, breathing */
      .hero {
        padding: clamp(5rem, 11vw, 8.2rem) 0 clamp(3.5rem, 7vw, 5.2rem);
        text-align: center;
      }

      .meta-line {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1.5rem;
      }

      h1 {
        font-size: clamp(2.6rem, 6vw, 4.5rem);
        line-height: 1.04;
        letter-spacing: -0.038em;
        font-weight: 700;
        margin: 0 auto 1.45rem;
        max-width: 18ch;
        background: linear-gradient(180deg, #ffffff 30%, #cbd5e1 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .lead {
        font-size: clamp(1.05rem, 1.5vw, 1.22rem);
        color: var(--ink-2);
        max-width: 56ch;
        margin: 0 auto 2.3rem;
        font-weight: 400;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.85rem;
        margin-bottom: 1.85rem;
      }

