      .code-tablist {
        display: flex;
        flex-wrap: wrap;
        border-bottom: 1px solid var(--rule);
        background: var(--bg-panel);
      }

      .code-tab {
        appearance: none;
        border: none;
        border-right: 1px solid var(--rule);
        background: transparent;
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        padding: 0.65rem 1rem;
        cursor: pointer;
      }

      .code-tab[aria-selected='true'] {
        background: #0d1117;
        color: var(--accent);
      }

      .code-panel {
        display: none;
      }

      .code-panel.active {
        display: block;
      }

      .code-panel :global(pre) {
        margin: 0 !important;
        padding: 1.25rem 1.4rem !important;
        background: #0d1117 !important;
        font-family: var(--font-mono) !important;
        font-size: 0.8rem !important;
        line-height: 1.62 !important;
        overflow-x: auto;
      }

      .code-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.75rem 1.1rem;
        background: var(--bg-panel);
        border-top: 1px solid var(--rule);
        font-family: var(--font-mono);
        font-size: 0.77rem;
        color: var(--ink-2);
      }

      .code-foot code {
        color: var(--signal);
      }

      /* Progressive-disclosure documentation index */
      .doc-index {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
      }

      .doc-link {
        padding: 1.45rem 1.4rem 1.45rem 0;
        border-bottom: 1px solid var(--rule);
        transition: color 0.15s ease;
      }

      .doc-link:not(:nth-child(3n)) {
        padding-right: 1.75rem;
      }

      .doc-link:hover h3 {
        color: var(--accent);
      }

      .doc-link h3 {
        margin: 0 0 0.35rem;
        font-size: 0.96rem;
        font-weight: 600;
        transition: color 0.15s ease;
      }

      .doc-link p {
        margin: 0;
        font-size: 0.85rem;
        color: var(--ink-2);
        line-height: 1.5;
      }

      footer {
        border-top: 1px solid var(--rule);
        padding: 2.25rem 0 3.25rem;
        font-size: 0.83rem;
        color: var(--ink-3);
      }

      .foot-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.35rem;
        font-family: var(--font-mono);
        font-size: 0.76rem;
      }

      .foot-links a:hover {
        color: var(--ink);
      }

      @media (max-width: 900px) {
        .evidence {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .ev-item:nth-child(2) {
          border-right: none;
        }
        .ev-item:nth-child(1),
        .ev-item:nth-child(2) {
          border-bottom: 1px solid var(--rule);
        }
        .pillars,
        .asset-panel,
        .doc-index {
          grid-template-columns: 1fr;
        }
        .doc-link:not(:nth-child(3n)) {
          padding-right: 0;
        }
      }

      @media (max-width: 720px) {
        .nav-links a:not(.nav-gh):not(.nav-docs) {
          display: none;
        }
      }
    </style>
