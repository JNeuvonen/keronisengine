        outline-offset: 2px;
      }

      .pause-btn {
        appearance: none;
        background: transparent;
        border: 1px solid var(--rule-strong);
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        padding: 0.34rem 0.72rem;
        border-radius: 4px;
        cursor: pointer;
      }

      .pause-btn:hover {
        border-color: var(--accent);
        color: var(--ink);
      }

      .stage-view {
        display: none;
        padding: 1.65rem 1.35rem;
        overflow-x: auto;
      }

      .stage-view.active {
        display: block;
      }

      .stage-view svg {
        display: block;
        width: 100%;
        min-width: 780px;
        height: auto;
      }

      .trace-flow {
        stroke-dasharray: 7 9;
      }

      .trace-flow-slow {
        stroke-dasharray: 5 11;
      }

      @media (prefers-reduced-motion: no-preference) {
        .blueprint:not(.is-paused) .trace-flow {
          animation: flowDash 1.15s linear infinite;
        }
        .blueprint:not(.is-paused) .trace-flow-slow {
          animation: flowDash 2.1s linear infinite;
        }
