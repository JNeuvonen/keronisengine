<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #07090e;
        --bg-elevated: #0c1018;
        --bg-card: #0e131e;
        --border: #1b2434;
        --border-bright: #28364d;
        --text: #eef2f7;
        --text-muted: #94a3b8;
        --text-dim: #64748b;
        --cyan: #22d3ee;
        --cyan-soft: rgba(34, 211, 238, 0.12);
        --emerald: #34d399;
        --emerald-soft: rgba(52, 211, 153, 0.12);
        --amber: #fbbf24;
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .backdrop {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image:
          radial-gradient(ellipse 75% 45% at 50% -8%, rgba(34, 211, 238, 0.13), transparent 70%),
          radial-gradient(ellipse 40% 35% at 85% 18%, rgba(52, 211, 153, 0.07), transparent 65%),
          radial-gradient(rgba(148, 163, 184, 0.1) 1px, transparent 1px);
        background-size: 100% 100%, 100% 100%, 28px 28px;
      }

      .wrap {
        position: relative;
        z-index: 1;
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(14px);
        background: rgba(7, 9, 14, 0.8);
        border-bottom: 1px solid var(--border);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
        gap: 1rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 700;
        font-size: 1.02rem;
        letter-spacing: -0.02em;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.4rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .nav-gh {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.42rem 0.8rem;
        border-radius: 0.45rem;
        border: 1px solid var(--border-bright);
        color: var(--text) !important;
        font-size: 0.85rem;
        font-weight: 500;
        background: rgba(255, 255, 255, 0.02);
      }

      .nav-gh:hover {
        border-color: var(--cyan);
      }

      .hero {
        padding: clamp(3.2rem, 7vw, 5.8rem) 0 2.6rem;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.76rem;
        color: var(--cyan);
        background: var(--cyan-soft);
        border: 1px solid rgba(34, 211, 238, 0.28);
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        margin-bottom: 1.35rem;
      }

      .eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--emerald);
        box-shadow: 0 0 10px var(--emerald);
      }

      h1 {
        font-size: clamp(2.35rem, 5.2vw, 4rem);
        line-height: 1.05;
        letter-spacing: -0.035em;
        font-weight: 800;
        margin: 0 0 1.2rem;
        max-width: 18ch;
      }

      .grad {
        background: linear-gradient(110deg, #f8fafc 15%, #67e8f9 65%, #34d399 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .lead {
        font-size: clamp(1.03rem, 1.4vw, 1.18rem);
        color: var(--text-muted);
        max-width: 66ch;
        margin: 0 0 1.9rem;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.75rem 1.3rem;
        border-radius: 0.5rem;
        font-size: 0.92rem;
        font-weight: 600;
        transition: transform 0.14s ease, border-color 0.14s ease, background 0.14s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-primary {
        background: var(--cyan);
        color: #06131a;
      }

      .btn-secondary {
        background: var(--bg-card);
        border: 1px solid var(--border-bright);
        color: var(--text);
      }

      .btn-secondary:hover {
        border-color: var(--cyan);
      }

      .cmd-bar {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        max-width: 100%;
        padding: 0.65rem 0.95rem;
        border-radius: 0.55rem;
        border: 1px solid var(--border);
        background: var(--bg-elevated);
        font-family: var(--font-mono);
        font-size: 0.82rem;
        color: #cbd5e1;
        overflow-x: auto;
      }

      .cmd-bar .prompt {
        color: var(--emerald);
        user-select: none;
      }

      .copy-btn {
        background: transparent;
        border: 1px solid var(--border-bright);
        color: var(--text-muted);
        border-radius: 0.35rem;
        padding: 0.25rem 0.55rem;
        font-family: var(--font-mono);
        font-size: 0.74rem;
        cursor: pointer;
        flex-shrink: 0;
      }

      .copy-btn:hover {
        color: var(--text);
        border-color: var(--cyan);
      }

      .metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.9rem;
        margin: 2.6rem 0 0;
      }

      .metric {
        padding: 1.1rem 1.2rem;
        border-radius: 0.7rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
      }

      .metric-val {
        font-family: var(--font-mono);
        font-size: 1.42rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.02em;
      }

      .metric-val span {
        color: var(--cyan);
      }

      .metric-lbl {
        margin-top: 0.35rem;
        font-size: 0.83rem;
        color: var(--text-muted);
      }

      section {
        margin-bottom: 4.4rem;
      }

      .sec-kicker {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--cyan);
        margin-bottom: 0.45rem;
      }

      h2 {
        font-size: clamp(1.5rem, 2.7vw, 2.1rem);
        letter-spacing: -0.025em;
        margin: 0 0 0.65rem;
        line-height: 1.18;
      }

      .sec-desc {
        color: var(--text-muted);
        max-width: 68ch;
        margin: 0 0 1.65rem;
        font-size: 0.97rem;
      }

      /* Architecture schematic SVG */
      .diagram-shell {
        border-radius: 0.8rem;
        border: 1px solid var(--border-bright);
        background: linear-gradient(180deg, rgba(12, 16, 26, 0.96), rgba(8, 11, 18, 0.98));
        padding: 1.25rem;
        overflow-x: auto;
      }

      .diagram-shell svg {
        display: block;
        width: 100%;
        min-width: 740px;
        height: auto;
      }

      /* Market & strategy coverage grid */
      .bento {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
      }

      .card {
        padding: 1.35rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border);
        background: var(--bg-card);
        transition: border-color 0.15s ease;
      }

      .card:hover {
        border-color: var(--border-bright);
      }

      .card-tag {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--cyan);
        margin-bottom: 0.4rem;
      }

      .card h3 {
        margin: 0 0 0.45rem;
        font-size: 1.02rem;
      }

      .card p {
        margin: 0;
        font-size: 0.87rem;
        color: var(--text-muted);
      }

      /* Flagship examples */
      .examples-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.1rem;
      }

      .example-card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        border-radius: 0.8rem;
        border: 1px solid var(--border-bright);
        background: linear-gradient(180deg, rgba(16, 22, 35, 0.95), rgba(11, 15, 24, 0.98));
      }

      .example-card.cyan-accent {
        border-color: rgba(34, 211, 238, 0.34);
      }

      .example-card.emerald-accent {
        border-color: rgba(52, 211, 153, 0.34);
      }

      .example-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }

      .pill {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        padding: 0.22rem 0.6rem;
        border-radius: 999px;
        border: 1px solid var(--border-bright);
        color: var(--cyan);
        background: var(--cyan-soft);
      }

      .pill.emerald {
        color: var(--emerald);
        background: var(--emerald-soft);
        border-color: rgba(52, 211, 153, 0.3);
      }

      .example-card h3 {
        margin: 0 0 0.45rem;
        font-size: 1.18rem;
        letter-spacing: -0.015em;
      }

      .example-card .summary {
        margin: 0 0 1.1rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      .spec-list {
        margin: 0 0 1.25rem;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-muted);
      }

      .spec-list li {
        display: grid;
        grid-template-columns: 88px 1fr;
        gap: 0.6rem;
      }

      .spec-list strong {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        color: var(--text);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding-top: 0.12rem;
      }

      .example-links {
        margin-top: auto;
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        padding-top: 0.9rem;
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
        font-weight: 600;
      }

      .example-links a {
        color: var(--cyan);
      }

      .example-links a:hover {
        text-decoration: underline;
      }

      /* Code tabs */
      .code-shell {
        border-radius: 0.75rem;
        border: 1px solid var(--border-bright);
        background: #0a0e16;
        overflow: hidden;
      }

      .tablist {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        padding: 0.55rem 0.75rem;
        background: #0d121d;
        border-bottom: 1px solid var(--border);
      }

      .tab {
        appearance: none;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        padding: 0.45rem 0.85rem;
        border-radius: 0.45rem;
        cursor: pointer;
      }

      .tab:focus-visible {
        outline: 2px solid var(--cyan);
        outline-offset: 2px;
      }

      .tab[aria-selected='true'] {
        background: var(--cyan-soft);
        border-color: rgba(34, 211, 238, 0.32);
        color: var(--cyan);
      }

      .tabpanel {
        display: none;
        margin: 0;
        padding: 1.25rem 1.4rem;
        overflow-x: auto;
        font-family: var(--font-mono);
        font-size: 0.81rem;
        line-height: 1.62;
        color: #dbeafe;
      }

      .tabpanel.active {
        display: block;
      }

      .code-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.75rem 1.25rem;
        background: #0d121d;
        border-top: 1px solid var(--border);
        font-size: 0.82rem;
        color: var(--text-muted);
      }

      .code-foot code {
        font-family: var(--font-mono);
        color: var(--emerald);
      }

      .code-foot a {
        color: var(--cyan);
        font-weight: 600;
      }

      /* Differentiator 2-col */
      .diff-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: 1rem;
      }

      .diff-card {
        padding: 1.45rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border);
        background: var(--bg-card);
      }

      .diff-card.accent {
        border-color: rgba(34, 211, 238, 0.35);
        background: linear-gradient(180deg, rgba(8, 30, 42, 0.45), rgba(14, 19, 30, 0.96));
      }

      .diff-card h3 {
        margin: 0 0 0.75rem;
        font-size: 1.05rem;
      }

      .diff-card ul {
        margin: 0;
        padding-left: 1.15rem;
        color: var(--text-muted);
        font-size: 0.9rem;
      }

      .diff-card li + li {
        margin-top: 0.5rem;
      }

      /* Scope box */
      .scope-box {
        padding: 1.35rem 1.5rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border-bright);
        background: var(--bg-elevated);
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.25rem;
        font-size: 0.88rem;
      }

      .scope-box strong {
        display: block;
        margin-bottom: 0.3rem;
        color: var(--text);
      }

      .scope-box p {
        margin: 0;
        color: var(--text-muted);
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 2rem 0 3rem;
        color: var(--text-dim);
        font-size: 0.85rem;
      }

      .foot-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
      }

      .foot-links a:hover {
        color: var(--text);
      }

      @media (max-width: 760px) {
        .nav-links a:not(.nav-gh):not(.nav-docs) {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="backdrop" aria-hidden="true"></div>

    <header>
      <div class="wrap nav">
        <a href="/" class="brand">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="28" height="28" fill="none">
            <rect x="2" y="2" width="28" height="28" rx="6" fill="#0b111b" stroke="#22d3ee" stroke-width="1.5" />
            <path d="M10 8v16M10 16l9-8M14.5 12l7.5 12" stroke="#e2e8f0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="22" cy="9.5" r="2" fill="#22d3ee" />
          </svg>
