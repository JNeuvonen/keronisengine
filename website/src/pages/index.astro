---
import { Code } from '@astrojs/starlight/components';

const title = 'KeronisEngine — Systematic Trading & Predictive-Model Infrastructure';
const description =
  'Open-source C++20 infrastructure that unifies quantitative feature research, offline training panels, simulation, in-process ONNX inference, and live multi-venue execution in one compiled system.';

const codePolymarketDigital = `// src/cpp/packages/strategies/polymarket_digital/polymarket_digital.cpp
// Polymarket digital options market making / high-frequency pricer:
// Prices P(S_T > K) from live Binance spot (swap fair_prob_yes with OnnxModel::predict)
// and quotes/executes YES or NO on the Polymarket CLOB when edge exceeds threshold.
double fair_prob_yes(double spot, double strike, double tau_sec) {
    const double denom = kAnnualVol * std::sqrt(tau_sec / kSecondsPerYear);
    if (denom <= 1e-9) return spot >= strike ? 1.0 : 0.0;
    return std::clamp(normal_cdf(std::log(spot / strike) / denom), 0.01, 0.99);
}

std::vector<Core::StrategyDecision> on_market_event(
    Core::Engine& engine, Core::Strategy& strategy,
    std::optional<Core::MarketEvent>) {
    std::vector<Core::StrategyDecision> decisions;
    const long long now_ms = engine.get_time();

    auto tickers_lock = strategy.lock_on_pred_market_strat();
    for (auto& [symbol, ticker] : strategy.trade_tickers) {
        std::lock_guard<std::mutex> lock(ticker->trading_mutex);
        if (ticker->clob_ids_by_index.size() < 2 || !ticker->get_orders(false).empty()) continue;

        const long long remaining_ms = ticker->event_end_time_ms.load() - now_ms;
        const auto spot = engine.get_price(ticker->underlying_symbol, "binance", "swap");
        if (remaining_ms < kMinRemainingMs || !spot || *spot <= 0.0) continue;

        const double p_yes = fair_prob_yes(*spot, ticker->strike_price, remaining_ms / 1000.0);
        const double fair[2] = {p_yes, 1.0 - p_yes};
        const double tick = ticker->order_price_min_tick_size.load();

        Core::StrategyDecision decision;
        decision.symbol = symbol;
        for (int outcome = 0; outcome < 2; ++outcome) {
            if (ticker->get_outcome_exchange_inventory(outcome) >= kMaxOutcomePos) continue;
            const auto bba = ticker->read_outcome_bba(outcome);
            if (!bba || bba->best_ask <= 0.0 || (fair[outcome] - bba->best_ask) < kMinEdge) continue;

            auto [res, order] = ticker->construct_order(engine, strategy, make_limit_buy(
                symbol, round_to_tick(bba->best_ask, tick), kOrderShares, now_ms, *ticker, strategy));
            if (res == Core::OrderConstructionResult::VALID && order.has_value()) {
                auto o = order.value();
                o.is_prediction_market_order = true;
                o.clob_id = ticker->clob_ids_by_index[outcome];
                o.outcome_name = outcome == 0 ? "Yes" : "No";
                ticker->mark_order_to_be_created(engine, o, decision, strategy);
                break;
            }
        }
        if (!decision.orders.empty()) decisions.push_back(std::move(decision));
    }
    return decisions;
}

KERONIS_REGISTER_STRATEGY("polymarket_digital", bind_polymarket_digital);`;

const codeBinanceOnnx = `// src/cpp/packages/strategies/binance_onnx_perp/binance_onnx_perp.cpp
// Predictive-model perpetuals strategy:
// Streaming taker-flow features -> in-process ONNX inference -> risk-checked execution.
void compute_predictions(Core::Engine& engine, Core::Strategy& strategy) {
    auto sm = MarketData::StateMachineDispatcher::get_instance().get_machine(
        "windowed_taker_flow");
    auto features = sm ? sm->emit_state() : std::nullopt;
    if (!features || features->empty()) return;

    float score = 0.5f;
    if (!strategy.strategy_config.strategy_models.empty()) {
        auto model = get_or_load_model(
            strategy.strategy_config.strategy_models.front().path_to_model);
        if (model && features->size() == model->get_input_size()) {
            score = model->predict(*features);
        }
    }

    const long long now_ms = engine.get_time();
    for (auto& [symbol, ticker] : strategy.trade_tickers) {
        ticker->atomic_signal_main.store(score, now_ms);
    }
}

std::vector<Core::StrategyDecision> on_market_event(
    Core::Engine& engine, Core::Strategy& strategy,
    std::optional<Core::MarketEvent>) {
    std::vector<Core::StrategyDecision> decisions;
    for (auto& [symbol, ticker] : strategy.trade_tickers) {
        std::lock_guard<std::mutex> lock(ticker->trading_mutex);
        if (!ticker->get_orders(false).empty() || ticker->exchange_and_markets.empty()) continue;

        const auto [score, signal_ts] = ticker->atomic_signal_main.load();
        if (signal_ts <= 0) continue;

        const auto& em = ticker->exchange_and_markets.front();
        const auto price = engine.get_price(symbol, em.exchange_name, em.market_type);
        if (!price || *price <= 0.0) continue;

        Core::StrategyDecision decision;
        decision.symbol = symbol;
        const auto trades = ticker->get_trades(false);
        if (trades.empty() && score > kEnterThreshold) {
            Core::StrategyHelpers::submit_market_order(
                engine, strategy, *ticker, Core::OrderSide::BUY, *price,
                mpfr::mpreal(kOrderQty), decision);
        } else if (!trades.empty() && score < kExitThreshold) {
            Core::StrategyHelpers::close_trade_market(
                engine, strategy, *ticker, trades.front(), *price, decision);
        }
        if (!decision.orders.empty()) decisions.push_back(std::move(decision));
    }
    return decisions;
}

KERONIS_REGISTER_STRATEGY("binance_onnx_perp", bind_binance_onnx_perp);`;

const codeSpreadSm = `// src/cpp/packages/historical_feature_gen/src/transformations/spread_sm.cpp
// Streaming feature template: runs identically in offline Parquet training panels,
// historical backtests, paper trading, and live execution.
void SpreadSM::react_impl(const MarketData::MarketEvent& event) {
    if (event.type != MarketData::MarketEvent::BBA || !event.bba.has_value()) return;
    auto it = symbol_states_.find(event.symbol_key());
    if (it == symbol_states_.end()) return;

    const double bid = event.bba->bid_price;
    const double ask = event.bba->ask_price;
    if (bid <= 0.0 || ask <= 0.0 || ask < bid) return;

    it->second.last_bid = bid;
    it->second.last_ask = ask;
    it->second.has_bba = true;
}

std::optional<std::vector<float>> SpreadSM::emit_state_impl() const {
    if (symbol_states_.empty()) return std::nullopt;
    std::vector<float> result;
    result.reserve(symbol_states_.size());
    for (const auto& [key, state] : symbol_states_) {
        if (!state.has_bba) return std::nullopt;
        result.push_back(static_cast<float>(state.last_ask - state.last_bid));
    }
    return result;
}

KERONIS_REGISTER_STATE_MACHINE("spread", SpreadSM);`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #080a0e;
        --bg-panel: #0d1016;
        --bg-inset: #0a0d12;
        --rule: #1d2330;
        --rule-strong: #2d3748;
        --ink: #eaeef5;
        --ink-2: #9aa5b6;
        --ink-3: #647084;
        --accent: #38bdf8;
        --accent-dim: rgba(56, 189, 248, 0.1);
        --signal: #34d399;
        --artifact: #eab308;
        --font-sans: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
        --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
        line-height: 1.62;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.88em;
      }

      .wrap {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.75rem;
      }

      /* Structural top navigation */
      header {
        position: sticky;
        top: 0;
        z-index: 30;
        background: rgba(8, 10, 14, 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--rule);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 58px;
        gap: 1.5rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 600;
        font-size: 0.96rem;
        letter-spacing: -0.015em;
      }

      .brand-meta {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--ink-3);
        padding-left: 0.65rem;
        border-left: 1px solid var(--rule);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.6rem;
        font-size: 0.85rem;
        color: var(--ink-2);
      }

      .nav-links a:hover {
        color: var(--ink);
      }

      .nav-src {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--ink) !important;
        padding: 0.34rem 0.72rem;
        border: 1px solid var(--rule-strong);
        border-radius: 2px;
      }

      .nav-src:hover {
        border-color: var(--accent);
        color: var(--accent) !important;
      }

      /* Asymmetric Editorial Hero */
      .hero {
        padding: clamp(3.5rem, 7vw, 5.75rem) 0 4rem;
        border-bottom: 1px solid var(--rule);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
        gap: 3.5rem;
        align-items: start;
      }

      .doc-id {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1.35rem;
      }

      h1 {
        font-size: clamp(2.25rem, 4.5vw, 3.6rem);
        line-height: 1.08;
        letter-spacing: -0.032em;
        font-weight: 600;
        margin: 0 0 1.45rem;
        color: var(--ink);
      }

      .hero-thesis {
        font-size: 1.05rem;
        color: var(--ink-2);
        max-width: 58ch;
        margin: 0 0 1rem;
      }

      .hero-thesis strong {
        color: var(--ink);
        font-weight: 500;
      }

      .hero-sub {
        font-size: 0.94rem;
        color: var(--ink-3);
        max-width: 58ch;
        margin: 0 0 2rem;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.75rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.65rem 1.15rem;
        border-radius: 2px;
        font-size: 0.88rem;
        font-weight: 500;
        transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
      }

      .btn-primary {
        background: var(--ink);
        color: #080a0e;
        border: 1px solid var(--ink);
      }

      .btn-primary:hover {
        background: #ffffff;
      }

      .btn-outline {
        background: transparent;
        color: var(--ink);
        border: 1px solid var(--rule-strong);
      }

      .btn-outline:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .btn-text {
        padding: 0.65rem 0.25rem;
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.82rem;
      }

      .btn-text:hover {
        color: var(--accent);
      }

      .cli-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        max-width: 600px;
        padding: 0.6rem 0.85rem;
        background: var(--bg-panel);
        border: 1px solid var(--rule);
        border-radius: 2px;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--ink-2);
        overflow-x: auto;
      }

      .cli-row .ps {
        color: var(--signal);
        margin-right: 0.5rem;
        user-select: none;
      }

      .copy-btn {
        appearance: none;
        background: transparent;
        border: 1px solid var(--rule-strong);
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        padding: 0.2rem 0.55rem;
        border-radius: 2px;
        cursor: pointer;
        flex-shrink: 0;
      }

      .copy-btn:hover {
        border-color: var(--accent);
        color: var(--ink);
      }

      /* Right column: Hardware/System Specification Ledger */
      .spec-ledger {
        border: 1px solid var(--rule);
        background: var(--bg-panel);
        border-radius: 2px;
      }

      .spec-ledger-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--rule);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-3);
      }

      .spec-ledger-head span:last-child {
        color: var(--signal);
      }

      .spec-row {
        display: grid;
        grid-template-columns: 132px minmax(0, 1fr);
        gap: 0.75rem;
        padding: 0.72rem 1rem;
        border-bottom: 1px solid var(--rule);
        font-size: 0.82rem;
      }

      .spec-row:last-child {
        border-bottom: none;
      }

      .spec-k {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        color: var(--ink-3);
      }

      .spec-v {
        color: var(--ink);
        line-height: 1.45;
      }

      .spec-v .mono {
        font-family: var(--font-mono);
        color: var(--accent);
      }

      /* Section rhythm */
      section.block {
        padding: 4.5rem 0;
        border-bottom: 1px solid var(--rule);
      }

      .sec-grid-head {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 2.5rem;
        margin-bottom: 2.25rem;
        align-items: baseline;
      }

      .sec-num {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-3);
        padding-top: 0.35rem;
      }

      .sec-num strong {
        color: var(--accent);
        font-weight: 600;
        margin-right: 0.45rem;
      }

      h2 {
        font-size: clamp(1.5rem, 2.8vw, 2.05rem);
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.18;
        margin: 0 0 0.75rem;
      }

      .sec-lead {
        color: var(--ink-2);
        max-width: 66ch;
        margin: 0;
        font-size: 0.96rem;
      }

      /* Engineering Blueprint Architecture Stage */
      .blueprint {
        border: 1px solid var(--rule-strong);
        background: var(--bg-inset);
        border-radius: 2px;
        overflow: hidden;
      }

      .blueprint-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--rule);
        background: var(--bg-panel);
      }

      .seg-tabs {
        display: inline-flex;
        gap: 0.25rem;
      }

      .seg-tab {
        appearance: none;
        border: 1px solid transparent;
        background: transparent;
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.76rem;
        padding: 0.4rem 0.85rem;
        border-radius: 2px;
        cursor: pointer;
      }

      .seg-tab[aria-selected='true'] {
        border-color: var(--accent);
        background: var(--accent-dim);
        color: var(--accent);
      }

      .seg-tab:focus-visible,
      .pause-btn:focus-visible,
      .asset-tab:focus-visible,
      .code-tab:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .pause-btn {
        appearance: none;
        background: transparent;
        border: 1px solid var(--rule-strong);
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        padding: 0.34rem 0.72rem;
        border-radius: 2px;
        cursor: pointer;
      }

      .pause-btn:hover {
        border-color: var(--accent);
        color: var(--ink);
      }

      .stage-view {
        display: none;
        padding: 1.5rem 1.25rem;
        overflow-x: auto;
        background-image:
          linear-gradient(rgba(148, 163, 184, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(148, 163, 184, 0.04) 1px, transparent 1px);
        background-size: 24px 24px;
      }

      .stage-view.active {
        display: block;
      }

      .stage-view svg {
        display: block;
        width: 100%;
        min-width: 780px;
        height: auto;
      }

      .trace-flow {
        stroke-dasharray: 7 9;
      }

      .trace-flow-slow {
        stroke-dasharray: 5 11;
      }

      @media (prefers-reduced-motion: no-preference) {
        .blueprint:not(.is-paused) .trace-flow {
          animation: flowDash 1.1s linear infinite;
        }
        .blueprint:not(.is-paused) .trace-flow-slow {
          animation: flowDash 2s linear infinite;
        }
      }

      @keyframes flowDash {
        from {
          stroke-dashoffset: 32;
        }
        to {
          stroke-dashoffset: 0;
        }
      }

      /* 3-column invariants strip attached directly under blueprint */
      .invariants {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
        background: var(--bg-panel);
      }

      .inv-cell {
        padding: 1.15rem 1.25rem;
        border-right: 1px solid var(--rule);
      }

      .inv-cell:last-child {
        border-right: none;
      }

      .inv-id {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--accent);
        margin-bottom: 0.35rem;
      }

      .inv-cell h3 {
        margin: 0 0 0.35rem;
        font-size: 0.94rem;
        font-weight: 600;
      }

      .inv-cell p {
        margin: 0;
        font-size: 0.83rem;
        color: var(--ink-2);
        line-height: 1.5;
      }

      /* Section 02: Boundary Problem Thesis + Contrast Table */
      .thesis-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
        gap: 3rem;
        align-items: start;
      }

      .thesis-prose p {
        margin: 0 0 1.05rem;
        font-size: 0.95rem;
        color: var(--ink-2);
      }

      .thesis-prose p:last-child {
        margin-bottom: 0;
      }

      .thesis-prose strong {
        color: var(--ink);
        font-weight: 500;
      }

      .contrast-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid var(--rule);
        background: var(--bg-panel);
        font-size: 0.83rem;
      }

      .contrast-table th,
      .contrast-table td {
        text-align: left;
        padding: 0.8rem 0.95rem;
        border-bottom: 1px solid var(--rule);
        vertical-align: top;
      }

      .contrast-table th {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink-3);
        background: var(--bg-inset);
      }

      .contrast-table td:first-child {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        color: var(--ink-3);
        white-space: nowrap;
      }

      .contrast-table td:nth-child(2) {
        color: var(--ink-2);
      }

      .contrast-table td:nth-child(3) {
        color: var(--ink);
      }

      .contrast-table tr:last-child td {
        border-bottom: none;
      }

      /* Section 03: Interactive Venue / Asset Specification Matrix */
      .asset-tabs {
        display: flex;
        flex-wrap: wrap;
        border-bottom: 1px solid var(--rule);
        margin-bottom: 0;
      }

      .asset-tab {
        appearance: none;
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        padding: 0.75rem 1.15rem;
        cursor: pointer;
        margin-bottom: -1px;
      }

      .asset-tab:hover {
        color: var(--ink);
      }

      .asset-tab[aria-selected='true'] {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }

      .asset-panel {
        display: none;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        gap: 2.25rem;
        padding: 2rem 0 0;
        align-items: start;
      }

      .asset-panel.active {
        display: grid;
      }

      .asset-copy h3 {
        margin: 0 0 0.65rem;
        font-size: 1.2rem;
        font-weight: 600;
        letter-spacing: -0.015em;
      }

      .asset-copy p {
        margin: 0 0 1.2rem;
        font-size: 0.93rem;
        color: var(--ink-2);
      }

      .venue-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 1.25rem;
      }

      .vtag {
        font-family: var(--font-mono);
        font-size: 0.73rem;
        padding: 0.22rem 0.55rem;
        border: 1px solid var(--rule-strong);
        border-radius: 2px;
        color: var(--ink-2);
      }

      .vtag.native {
        border-color: rgba(52, 211, 153, 0.45);
        color: var(--signal);
      }

      .inline-link {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--accent);
      }

      .inline-link:hover {
        text-decoration: underline;
      }

      /* Trace / State Readout */
      .trace-box {
        border: 1px solid var(--rule-strong);
        background: var(--bg-panel);
        border-radius: 2px;
        font-family: var(--font-mono);
        font-size: 0.77rem;
      }

      .trace-head {
        display: flex;
        justify-content: space-between;
        padding: 0.55rem 0.9rem;
        border-bottom: 1px solid var(--rule);
        background: var(--bg-inset);
        color: var(--ink-3);
      }

      .trace-head span:last-child {
        color: var(--signal);
      }

      .trace-body {
        padding: 0.9rem 1rem;
        display: grid;
        gap: 0.5rem;
      }

      .trace-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        color: var(--ink-2);
      }

      .trace-row strong {
        color: var(--ink);
        font-weight: 500;
      }

      .trace-row .sig {
        color: var(--signal);
      }

      .trace-row .acc {
        color: var(--accent);
      }

      .trace-row .art {
        color: var(--artifact);
      }

      .trace-out {
        margin-top: 0.35rem;
        padding-top: 0.65rem;
        border-top: 1px solid var(--rule);
        color: var(--signal);
      }

      /* Section 04: Source Inspector */
      .code-shell {
        border: 1px solid var(--rule-strong);
        background: #0d1117;
        border-radius: 2px;
        overflow: hidden;
      }

      .code-tablist {
        display: flex;
        flex-wrap: wrap;
        border-bottom: 1px solid var(--rule);
        background: var(--bg-panel);
      }

      .code-tab {
        appearance: none;
        border: none;
        border-right: 1px solid var(--rule);
        background: transparent;
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        padding: 0.65rem 1rem;
        cursor: pointer;
      }

      .code-tab[aria-selected='true'] {
        background: #0d1117;
        color: var(--accent);
      }

      .code-panel {
        display: none;
      }

      .code-panel.active {
        display: block;
      }

      .code-panel :global(pre) {
        margin: 0 !important;
        padding: 1.25rem 1.4rem !important;
        background: #0d1117 !important;
        font-family: var(--font-mono) !important;
        font-size: 0.79rem !important;
        line-height: 1.62 !important;
        overflow-x: auto;
      }

      .code-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.72rem 1rem;
        background: var(--bg-panel);
        border-top: 1px solid var(--rule);
        font-family: var(--font-mono);
        font-size: 0.76rem;
        color: var(--ink-2);
      }

      .code-foot code {
        color: var(--signal);
      }

      /* Section 05: Technical Reading Index */
      .notes-index {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
      }

      .note-item {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: 0.85rem;
        padding: 1.35rem 1.25rem 1.35rem 0;
        border-bottom: 1px solid var(--rule);
        transition: background 0.15s ease;
      }

      .note-item:nth-child(odd) {
        padding-right: 2rem;
        border-right: 1px solid var(--rule);
      }

      .note-item:nth-child(even) {
        padding-left: 2rem;
      }

      .note-item:hover h3 {
        color: var(--accent);
      }

      .note-num {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        color: var(--ink-3);
        padding-top: 0.18rem;
      }

      .note-item h3 {
        margin: 0 0 0.3rem;
        font-size: 0.98rem;
        font-weight: 600;
        transition: color 0.15s ease;
      }

      .note-item p {
        margin: 0;
        font-size: 0.85rem;
        color: var(--ink-2);
        line-height: 1.5;
      }

      /* Footer colophon */
      footer {
        padding: 2.5rem 0 3.5rem;
        font-size: 0.82rem;
        color: var(--ink-3);
      }

      .foot-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 1.25rem;
      }

      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.35rem;
        font-family: var(--font-mono);
        font-size: 0.76rem;
      }

      .foot-links a:hover {
        color: var(--ink);
      }

      @media (max-width: 920px) {
        .hero-grid,
        .thesis-grid,
        .asset-panel,
        .sec-grid-head {
          grid-template-columns: 1fr;
          gap: 1.75rem;
        }
        .invariants,
        .notes-index {
          grid-template-columns: 1fr;
        }
        .inv-cell {
          border-right: none;
          border-bottom: 1px solid var(--rule);
        }
        .inv-cell:last-child {
          border-bottom: none;
        }
        .note-item:nth-child(odd) {
          border-right: none;
          padding-right: 0;
        }
        .note-item:nth-child(even) {
          padding-left: 0;
        }
      }

      @media (max-width: 720px) {
        .brand-meta,
        .nav-links a:not(.nav-src):not(.nav-docs) {
          display: none;
