const title = 'KeronisEngine — C++20 Execution Built for Predictive Models';
const description =
  'Open-source C++20 execution and real-time ML inference engine. Sub-millisecond tick-to-ONNX-to-order execution for crypto, Polymarket, and event markets on commodity hardware.';

const codeBinanceOnnx = `// src/cpp/packages/strategies/binance_onnx_perp/binance_onnx_perp.cpp
void compute_predictions(Core::Engine& engine, Core::Strategy& strategy) {
    auto sm = MarketData::StateMachineDispatcher::get_instance().get_machine(
        "windowed_taker_flow");
    auto features = sm ? sm->emit_state() : std::nullopt;
    if (!features || features->empty()) return;

    float score = 0.5f;
    if (!strategy.strategy_config.strategy_models.empty()) {
        auto model = get_or_load_model(
            strategy.strategy_config.strategy_models.front().path_to_model);
        if (model && features->size() == model->get_input_size()) {
            score = model->predict(*features);
        }
    }

    const long long now_ms = engine.get_time();
    for (auto& [symbol, ticker] : strategy.trade_tickers) {
        ticker->atomic_signal_main.store(score, now_ms);
    }
}

std::vector<Core::StrategyDecision> on_market_event(
    Core::Engine& engine, Core::Strategy& strategy,
    std::optional<Core::MarketEvent>) {
    std::vector<Core::StrategyDecision> decisions;
    for (auto& [symbol, ticker] : strategy.trade_tickers) {
        std::lock_guard<std::mutex> lock(ticker->trading_mutex);
        if (!ticker->get_orders(false).empty() || ticker->exchange_and_markets.empty()) continue;

        const auto [score, signal_ts] = ticker->atomic_signal_main.load();
        if (signal_ts <= 0) continue;

        const auto& em = ticker->exchange_and_markets.front();
        const auto price = engine.get_price(symbol, em.exchange_name, em.market_type);
        if (!price || *price <= 0.0) continue;

        Core::StrategyDecision decision;
        decision.symbol = symbol;
        const auto trades = ticker->get_trades(false);
        if (trades.empty() && score > kEnterThreshold) {
            Core::StrategyHelpers::submit_market_order(
                engine, strategy, *ticker, Core::OrderSide::BUY, *price,
                mpfr::mpreal(kOrderQty), decision);
        } else if (!trades.empty() && score < kExitThreshold) {
            Core::StrategyHelpers::close_trade_market(
                engine, strategy, *ticker, trades.front(), *price, decision);
        }
        if (!decision.orders.empty()) decisions.push_back(std::move(decision));
    }
    return decisions;
}

KERONIS_REGISTER_STRATEGY("binance_onnx_perp", bind_binance_onnx_perp);`;

const codePolymarketDigital = `// src/cpp/packages/strategies/polymarket_digital/polymarket_digital.cpp
double fair_prob_yes(double spot, double strike, double tau_sec) {
    const double denom = kAnnualVol * std::sqrt(tau_sec / kSecondsPerYear);
    if (denom <= 1e-9) return spot >= strike ? 1.0 : 0.0;
    return std::clamp(normal_cdf(std::log(spot / strike) / denom), 0.01, 0.99);
}

std::vector<Core::StrategyDecision> on_market_event(
    Core::Engine& engine, Core::Strategy& strategy,
    std::optional<Core::MarketEvent>) {
    std::vector<Core::StrategyDecision> decisions;
    const long long now_ms = engine.get_time();

    auto tickers_lock = strategy.lock_on_pred_market_strat();
    for (auto& [symbol, ticker] : strategy.trade_tickers) {
        std::lock_guard<std::mutex> lock(ticker->trading_mutex);
        if (ticker->clob_ids_by_index.size() < 2 || !ticker->get_orders(false).empty()) continue;

        const long long remaining_ms = ticker->event_end_time_ms.load() - now_ms;
        const auto spot = engine.get_price(ticker->underlying_symbol, "binance", "swap");
        if (remaining_ms < kMinRemainingMs || !spot || *spot <= 0.0) continue;

        const double p_yes = fair_prob_yes(*spot, ticker->strike_price, remaining_ms / 1000.0);
        const double fair[2] = {p_yes, 1.0 - p_yes};
        const double tick = ticker->order_price_min_tick_size.load();

        Core::StrategyDecision decision;
        decision.symbol = symbol;
        for (int outcome = 0; outcome < 2; ++outcome) {
            if (ticker->get_outcome_exchange_inventory(outcome) >= kMaxOutcomePos) continue;
            const auto bba = ticker->read_outcome_bba(outcome);
            if (!bba || bba->best_ask <= 0.0 || (fair[outcome] - bba->best_ask) < kMinEdge) continue;

            auto [res, order] = ticker->construct_order(engine, strategy, make_limit_buy(
                symbol, round_to_tick(bba->best_ask, tick), kOrderShares, now_ms, *ticker, strategy));
            if (res == Core::OrderConstructionResult::VALID && order.has_value()) {
                auto o = order.value();
                o.is_prediction_market_order = true;
                o.clob_id = ticker->clob_ids_by_index[outcome];
                o.outcome_name = outcome == 0 ? "Yes" : "No";
                ticker->mark_order_to_be_created(engine, o, decision, strategy);
                break;
            }
        }
        if (!decision.orders.empty()) decisions.push_back(std::move(decision));
    }
    return decisions;
}

KERONIS_REGISTER_STRATEGY("polymarket_digital", bind_polymarket_digital);`;

const codeSpreadSm = `// src/cpp/packages/historical_feature_gen/src/transformations/spread_sm.cpp
void SpreadSM::react_impl(const MarketData::MarketEvent& event) {
    if (event.type != MarketData::MarketEvent::BBA || !event.bba.has_value()) return;
    auto it = symbol_states_.find(event.symbol_key());
    if (it == symbol_states_.end()) return;

    const double bid = event.bba->bid_price;
    const double ask = event.bba->ask_price;
    if (bid <= 0.0 || ask <= 0.0 || ask < bid) return;

    it->second.last_bid = bid;
    it->second.last_ask = ask;
    it->second.has_bba = true;
}

std::optional<std::vector<float>> SpreadSM::emit_state_impl() const {
    if (symbol_states_.empty()) return std::nullopt;
    std::vector<float> result;
    result.reserve(symbol_states_.size());
    for (const auto& [key, state] : symbol_states_) {
        if (!state.has_bba) return std::nullopt;
        result.push_back(static_cast<float>(state.last_ask - state.last_bid));
    }
    return result;
}

std::vector<std::string> SpreadSM::feature_names() const {
    std::vector<std::string> names;
    for (const auto& [key, _] : symbol_states_) names.push_back(key + ":spread");
    return names;
}

KERONIS_REGISTER_STATE_MACHINE("spread", SpreadSM);`;
