---
const GH = 'https://github.com/JNeuvonen/keronisengine/blob/main';

const steps = [
  {
    idx: 0,
    col: 0,
    headline: 'MarketDataStreams parses raw wire JSON via simdjson & fans out',
    sync: 'Feeds BarAggregator, StateMachineDispatcher, DataRecorder & live_event_queue_',
    dataTitle: 'Raw Binance Futures Wire Frame (btcusdt@trade)',
    data: `{
  "e": "trade",
  "E": 1732632012418,
  "T": 1732632012416,
  "s": "BTCUSDT",
  "t": 5481920411,
  "p": "100420.50",
  "q": "1.85",
  "m": false
}`,
    links: [
      { label: 'normalized_trade.cpp:59', href: `${GH}/src/cpp/packages/market_data/src/normalized_trade.cpp#L59` },
      { label: 'market_data_streams.cpp:1423–1444', href: `${GH}/src/cpp/packages/market_data/src/market_data_streams.cpp#L1423-L1444` },
    ],
    code: `DataRecorder::getInstance().record_with_symbol(..., msg);
BarAggregator::getInstance().add_trade(trade, true);
StateMachineDispatcher::get_instance().enqueue(MarketEvent(ev));
live_event_callback_(std::move(ev));`,
  },
  {
    idx: 1,
    col: 1,
    headline: 'BarAggregator builds live OHLCV bars in parallel with Feature SMs',
    sync: 'BarAggregator::add_trade() → OhlcvDataset (time / volume bars)',
    dataTitle: 'OhlcvDataset Bar State (readable by T3 & T4)',
    data: `bar_policy:  time_bars(60'000 ms)  // or volume / custom bars
ohlcv_tick:  { open: 100412.0, high: 100421.0, low: 100410.5, close: 100420.5 }
volume:      48.62 BTC  (taker_buy_vol: 31.40 BTC)
consumers:   compute_predictions_callback & strategy_callback`,
    links: [
      { label: 'market_data_streams.cpp:1428', href: `${GH}/src/cpp/packages/market_data/src/market_data_streams.cpp#L1428` },
      { label: 'bar_close_policy.h', href: `${GH}/src/cpp/packages/market_data/include/market_data/bar_close_policy.h` },
    ],
    code: `BarAggregator::getInstance().add_trade(trade, true);
// Strategies declare required_bar_types and read OhlcvDataset directly`,
  },
  {
    idx: 2,
    col: 1,
    headline: 'Dedicated SM thread updates your compiled C++ feature state',
    sync: 'StateMachineDispatcher::consumer_loop · shared offline & live C++',
    dataTitle: 'YourFeatureSM::emit_state() -> vector<float>',
    data: `// Plug in any StrategyStateMachine (out-of-tree via -DKERONIS_STRATEGY_DIRS)
emit_state() -> float[N] {
  your_feature_0:  0.780f,
  your_feature_1:  14.0f,
  your_feature_2:  0.412f,
  ...
  your_feature_n:  -0.195f
}`,
    links: [
      { label: 'state_machine_dispatcher.cpp:64', href: `${GH}/src/cpp/packages/market_data/src/state_machine_dispatcher.cpp#L64` },
      { label: 'strategy_state_machine.h', href: `${GH}/src/cpp/packages/market_data/include/market_data/strategy_state_machine.h` },
    ],
    code: `// Versioned local snapshot: no mutex on hot path
for (auto& sm : snapshot) {
    sm->react(event);
}`,
  },
  {
    idx: 3,
    col: 2,
    headline: 'Prediction callback runs on predictions_pool & stores atomic signal',
    sync: 'compute_predictions_callback (ONNX or custom C++ model) → atomic_signal_main',
    dataTitle: 'compute_predictions_callback → AtomicSignal',
    data: `callback:           compute_predictions_callback (async pool)
inputs:             sm->emit_state() and/or OhlcvDataset bars
runtime:            ONNX Runtime C++ session (or custom pricer)
atomic_signal_main: store(0.712f, 1732632012418)`,
    links: [
      { label: 'engine.cpp:111, 728', href: `${GH}/src/cpp/packages/trading_engine/src/engine.cpp#L728` },
      { label: 'binance_onnx_perp.cpp:34', href: `${GH}/src/cpp/packages/strategies/binance_onnx_perp/binance_onnx_perp.cpp#L34` },
    ],
    code: `float score = model->predict(*features);
ticker->atomic_signal_main.store(score, now_ms);`,
  },
  {
    idx: 4,
    col: 3,
    headline: 'Execution callback reads signal, bars & books and returns StrategyDecision',
    sync: 'strategy_callback · trading_mutex → construct_order() → enqueue_order_task()',
    dataTitle: 'strategy_callback → StrategyDecision',
    data: `callback:    strategy_callback (strategy_thread_pool)
inputs:      atomic_signal_main.load() + live books & OHLCV bars
risk_gate:   trading_mutex · quotes_pulled=false · caps=PASS
return:      StrategyDecision { orders: [BUY 0.01 MARKET] }`,
    links: [
      { label: 'engine.cpp:109, 871', href: `${GH}/src/cpp/packages/trading_engine/src/engine.cpp#L871` },
      { label: 'binance_onnx_perp.cpp:57', href: `${GH}/src/cpp/packages/strategies/binance_onnx_perp/binance_onnx_perp.cpp#L57` },
    ],
    code: `std::lock_guard lock(ticker->trading_mutex);
auto [score, ts] = ticker->atomic_signal_main.load();
StrategyHelpers::submit_market_order(..., decision);`,
  },
  {
    idx: 5,
    col: 4,
    headline: 'Dedicated order_thread_pool (200) & cancel pool (100) post to venues',
    sync: 'enqueue_order_task (200w) · enqueue_cancel_order_task (100w) · non-blocking',
    dataTitle: 'Order Posting & Cancel Pools (separate from strategy_pool)',
    data: `create_pool: order_thread_pool (200 workers) -> on_create_order[_bulk]
cancel_pool: cancel_order_thread_pool (100 workers) -> on_cancel_order
direct_sign: Polymarket (EIP-712 bulk) · Hyperliquid (Rust) · Aster
proxy / sim: cpp_live_proxy (CCXT · IBKR) · PaperExchange · BacktestState`,
    links: [
      { label: 'engine.cpp:107–108', href: `${GH}/src/cpp/packages/trading_engine/src/engine.cpp#L107-L108` },
      { label: 'strategy.cpp:459, 484–498', href: `${GH}/src/cpp/packages/trading_engine/src/strategy.cpp#L484-L498` },
    ],
    code: `engine.enqueue_order_task([this, &engine, order]() mutable {
    this->on_create_order(engine, order);
});`,
  },
];
---

<div class="ep" id="exec-path" data-step="0">
  <div class="ep-top">
    <div class="ep-legend" aria-label="Diagram key">
      <span><i class="dot dot-comp"></i>Active compute</span>
      <span><i class="dot dot-queue"></i>Lock-free queue</span>
      <span><i class="dot dot-atom"></i>Atomic register</span>
    </div>
    <div class="ep-ctrl">
      <span class="ep-step-num" id="ep-counter">Stage 1 / 6</span>
      <button type="button" class="ep-btn" id="ep-prev" aria-label="Previous stage">←</button>
      <button type="button" class="ep-btn" id="ep-next" aria-label="Next stage">→</button>
      <button type="button" class="ep-btn ep-play" id="ep-play">Pause</button>
    </div>
  </div>

  <!-- 5-column vertical swimlanes with parallel BarAggregator + Feature SM stacked in Column 2 -->
  <div class="ep-stage">
    <svg
      viewBox="0 0 1180 370"
      role="img"
      aria-label="Vertical thread swimlane visualization showing raw trade ticks fanning out in parallel to BarAggregator (OHLCV) and StateMachineDispatcher (Feature SM), then converging asynchronously into Prediction Callback, Execution Callback, and the 200-worker Order Posting Pool"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <marker id="arr-muted" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#64748b" />
        </marker>
        <marker id="arr-queue" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#60a5fa" />
        </marker>
        <marker id="arr-atom" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#d4a359" />
        </marker>
      </defs>

      <!-- 5 Vertical Thread Swimlane Backgrounds -->
      <rect class="col-bg" data-col="0" x="0" y="0" width="206" height="320" fill="transparent" />
      <rect class="col-bg" data-col="1" x="242" y="0" width="206" height="320" fill="transparent" />
      <rect class="col-bg" data-col="2" x="484" y="0" width="206" height="320" fill="transparent" />
      <rect class="col-bg" data-col="3" x="726" y="0" width="206" height="320" fill="transparent" />
      <rect class="col-bg" data-col="4" x="968" y="0" width="212" height="320" fill="transparent" />

      <!-- Vertical thread boundary hairlines -->
      <line x1="224" y1="8" x2="224" y2="318" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="466" y1="8" x2="466" y2="318" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="708" y1="8" x2="708" y2="318" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="950" y1="8" x2="950" y2="318" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />

      <!-- Thread Column Headers -->
      <text x="14" y="24" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T1 · MarketDataStreams</text>
      <text x="14" y="40" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">WS I/O + simdjson</text>

      <text x="256" y="24" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T2 · Bars &amp; Feature SMs</text>
      <text x="256" y="40" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">Parallel state layers</text>

      <text x="498" y="24" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T3 · predictions_pool</text>
      <text x="498" y="40" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">hardware_concurrency()</text>

      <text x="740" y="24" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T4 · strategy_pool</text>
      <text x="740" y="40" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">hardware_concurrency()</text>

      <text x="982" y="24" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T5 · order_thread_pool</text>
      <text x="982" y="40" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">200 create · 100 cancel</text>

      <!-- FORK FROM COL 0 -> PARALLEL COL 1 TOP (BarAggregator) & COL 1 BOTTOM (Feature SM) -->
      <!-- Upper fork: Raw Trade -> BarAggregator -->
      <path d="M 192 182 L 214 182 L 214 118 L 254 118" fill="none" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-muted)" />
      <path class="flow-beam" data-beam="0" d="M 192 182 L 214 182 L 214 118 L 250 118" fill="none" stroke="#cbd5e1" stroke-width="2" />

      <!-- Lower fork: Raw Trade -> sm_queue_ -> Feature SM -->
      <path d="M 192 182 L 214 182 L 214 246 L 254 246" fill="none" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-queue)" />
      <path class="flow-beam" data-beam="1" d="M 192 182 L 214 182 L 214 246 L 250 246" fill="none" stroke="#60a5fa" stroke-width="2" />
      <!-- Discrete sm_queue_ ring buffer glyph on lower fork -->
      <g class="q-glyph" transform="translate(206, 236)">
        <rect x="0" y="0" width="36" height="20" rx="2" fill="#0b1220" stroke="#60a5fa" stroke-opacity="0.7" stroke-width="1.2" />
        <rect id="q-s0" x="4" y="4" width="7" height="12" rx="1" fill="#60a5fa" />
        <rect id="q-s1" x="14" y="4" width="7" height="12" rx="1" fill="#60a5fa" opacity="0.5" />
        <rect id="q-s2" x="24" y="4" width="7" height="12" rx="1" fill="#1e293b" />
      </g>
      <text x="224" y="294" text-anchor="middle" fill="#60a5fa" font-family="IBM Plex Mono, monospace" font-size="10">sm_queue_</text>

      <!-- CONVERGENCE FROM PARALLEL COL 1 -> COL 2 (Prediction Callback) + DIRECT BAR TAP -> COL 3 (Execution Callback) -->
      <!-- From BarAggregator (Top) -> Prediction Callback (Col 2) -->
      <path d="M 434 118 L 466 118 L 466 170 L 496 170" fill="none" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-muted)" />
      <path class="flow-beam" data-beam="2" d="M 434 118 L 466 118 L 466 170 L 492 170" fill="none" stroke="#cbd5e1" stroke-width="2" />

      <!-- Upper bypass: OhlcvDataset & live books -> Execution Callback (Col 3) -->
      <path d="M 466 118 L 466 72 L 829 72 L 829 144" fill="none" stroke="#222c3c" stroke-width="1.4" />
      <path class="async-pulse" d="M 466 118 L 466 72 L 829 72 L 829 144" fill="none" stroke="#94a3b8" stroke-width="1.6" marker-end="url(#arr-muted)" />
      <text x="650" y="63" text-anchor="middle" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">
        OhlcvDataset bars &amp; live books readable by both callbacks
      </text>

      <!-- From Feature SM (Bottom) -> Prediction Callback (Col 2) -->
      <path d="M 434 246 L 466 246 L 466 194 L 496 194" fill="none" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-muted)" />
      <path class="flow-beam" data-beam="3" d="M 434 246 L 466 246 L 466 194 L 492 194" fill="none" stroke="#cbd5e1" stroke-width="2" />
      <text x="466" y="294" text-anchor="middle" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10">emit_state()</text>

      <!-- HANDOFF COL 2 -> COL 3: atomic_signal_main -->
      <line x1="676" y1="182" x2="738" y2="182" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-atom)" />
      <line class="flow-beam" data-beam="4" x1="676" y1="182" x2="734" y2="182" stroke="#d4a359" stroke-width="2.2" />
      <g class="atom-glyph" transform="translate(683, 169)">
        <rect x="0" y="0" width="50" height="26" rx="2" fill="#15120b" stroke="#d4a359" stroke-width="1.3" />
        <text id="live-atom" x="25" y="17" text-anchor="middle" fill="#f3d092" font-family="IBM Plex Mono, monospace" font-size="10" font-weight="600">0.712</text>
      </g>
      <text x="708" y="294" text-anchor="middle" fill="#d4a359" font-family="IBM Plex Mono, monospace" font-size="10">atomic_signal</text>

      <!-- HANDOFF COL 3 -> COL 4: order_thread_pool queue -->
      <line x1="918" y1="182" x2="980" y2="182" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-queue)" />
      <line class="flow-beam" data-beam="5" x1="918" y1="182" x2="976" y2="182" stroke="#60a5fa" stroke-width="2" />
      <g class="q-glyph" transform="translate(932, 172)">
        <rect x="0" y="0" width="36" height="20" rx="2" fill="#0b1220" stroke="#60a5fa" stroke-opacity="0.7" stroke-width="1.2" />
        <rect x="4" y="4" width="7" height="12" rx="1" fill="#60a5fa" />
        <rect x="14" y="4" width="7" height="12" rx="1" fill="#1e293b" />
        <rect x="24" y="4" width="7" height="12" rx="1" fill="#1e293b" />
      </g>
      <text x="950" y="294" text-anchor="middle" fill="#60a5fa" font-family="IBM Plex Mono, monospace" font-size="10">order_queue</text>

      <!-- 6 COMPACT STAGE NODES — STRICTLY 2 LINES PER BOX -->
      <!-- Node 0 (Col 0): Raw Trade -->
      <g class="ep-node is-active" data-node="0" role="button" tabindex="0" aria-label="Stage 1: Raw Trade ingest">
        <rect x="14" y="146" width="178" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="28" y="175" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">Raw Trade</text>
        <text id="live-t1" x="28" y="199" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">100420.50 · 1.85 BUY</text>
      </g>

      <!-- Node 1 (Col 1 Top): BarAggregator (OHLCV) -->
      <g class="ep-node" data-node="1" role="button" tabindex="0" aria-label="Stage 2: BarAggregator OHLCV">
        <rect x="256" y="82" width="178" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="270" y="111" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="13.5" font-weight="600">BarAggregator</text>
        <text id="live-bar" x="270" y="135" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">1m close 100420.50</text>
      </g>

      <!-- Node 2 (Col 1 Bottom): Feature SM -->
      <g class="ep-node" data-node="2" role="button" tabindex="0" aria-label="Stage 3: User-defined Feature SM">
        <rect x="256" y="210" width="178" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="270" y="239" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="13.5" font-weight="600">Feature SM</text>
        <text id="live-t2" x="270" y="263" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">float[N] seq #411</text>
      </g>

      <!-- Node 3 (Col 2): Prediction Callback -->
      <g class="ep-node" data-node="3" role="button" tabindex="0" aria-label="Stage 4: Strategy Prediction Callback">
        <rect x="498" y="146" width="178" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="512" y="175" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="13.5" font-weight="600">Prediction Callback</text>
        <text id="live-t3" x="512" y="199" fill="#f3d092" font-family="IBM Plex Mono, monospace" font-size="10.5">score 0.712</text>
      </g>

      <!-- Node 4 (Col 3): Execution Callback -->
      <g class="ep-node" data-node="4" role="button" tabindex="0" aria-label="Stage 5: Strategy Execution Callback">
        <rect x="740" y="146" width="178" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="754" y="175" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="13.5" font-weight="600">Execution Callback</text>
        <text id="live-t4" x="754" y="199" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">BUY 0.01 VALID</text>
      </g>

      <!-- Node 5 (Col 4): Order Posting -->
      <g class="ep-node" data-node="5" role="button" tabindex="0" aria-label="Stage 6: Order Posting Pool">
        <rect x="982" y="146" width="184" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="996" y="175" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="13.5" font-weight="600">Order Posting</text>
        <text id="live-t5" x="996" y="199" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">on_create_order</text>
      </g>

      <!-- Bottom bracket -->
      <path d="M 14 322 L 14 334 L 1166 334 L 1166 322" fill="none" stroke="#222c3c" stroke-width="1.2" />
      <text x="590" y="356" text-anchor="middle" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">
        &lt;1 ms tick → features → inference → order · strategies read OHLCV bars, Feature SMs, or both asynchronously
      </text>
    </svg>
  </div>

  <!-- Quiet, low-chrome data & source inspector with clickable GitHub links -->
  <div class="ep-inspector">
    {steps.map((s) => (
      <div class={`ep-row ${s.idx === 0 ? 'is-active' : ''}`} data-panel={s.idx}>
        <div class="ep-summary">
          <h3>{s.headline}</h3>
          <div class="ep-sync">{s.sync}</div>
          <div class="ep-src">
            <div class="ep-src-links">
              {s.links.map((lnk, li) => (
                <>
                  {li > 0 && <span class="ep-sep">·</span>}
                  <a href={lnk.href} target="_blank" rel="noopener noreferrer">{lnk.label} ↗</a>
                </>
              ))}
            </div>
            <pre><code>{s.code}</code></pre>
          </div>
        </div>
        <div class="ep-data">
          <div class="ep-data-title">{s.dataTitle}</div>
          <pre><code>{s.data}</code></pre>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .ep {
    margin-top: 0.5rem;
  }

  .ep-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  }

  .ep-legend {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .ep-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-comp {
    background: #f1f5f9;
  }

  .dot-queue {
    background: #60a5fa;
  }

  .dot-atom {
    background: #d4a359;
  }

  .ep-ctrl {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .ep-step-num {
    color: #8b96a8;
    margin-right: 0.4rem;
  }

  .ep-btn {
    appearance: none;
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #cbd5e1;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.24rem 0.6rem;
    border-radius: 3px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .ep-btn:hover {
    border-color: #94a3b8;
    color: #ffffff;
  }

  .ep-btn:focus-visible,
  .ep-node:focus-visible {
    outline: 2px solid #f1f5f9;
    outline-offset: 2px;
  }

  .ep-play.is-playing {
    border-color: rgba(212, 163, 89, 0.65);
    color: #f3d092;
  }

  .ep-stage {
    padding: 1.1rem 0 0.4rem;
    overflow-x: auto;
  }

  .ep-stage svg {
    display: block;
    width: 100%;
    min-width: 860px;
    height: auto;
  }

  .col-bg {
    transition: fill 0.22s ease;
  }

  .col-bg.is-active {
    fill: rgba(241, 245, 249, 0.028);
  }

  .ep-node {
    cursor: pointer;
  }

  .ep-node rect {
    transition: stroke 0.2s ease, fill 0.2s ease;
  }

  .ep-node:hover rect {
    stroke: rgba(148, 163, 184, 0.45);
  }

  .ep-node.is-active rect {
    stroke: #f1f5f9;
    fill: #111722;
    stroke-width: 1.6;
  }

  .async-pulse,
  .flow-beam {
    stroke-dasharray: 6 12;
    opacity: 0.22;
    transition: opacity 0.2s ease;
  }

  .flow-beam.is-active {
    opacity: 0.95;
  }

  .async-pulse.is-active {
    opacity: 0.78;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ep:not(.is-paused) .async-pulse {
      animation: epFlow 2.3s linear infinite;
    }
    .ep:not(.is-paused) .flow-beam.is-active {
      animation: epFlow 0.95s linear infinite;
    }
  }

  @keyframes epFlow {
    from {
      stroke-dashoffset: 36;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .ep-inspector {
    margin-top: 0.6rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(148, 163, 184, 0.14);
  }

  .ep-row {
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    gap: 2.25rem;
    align-items: start;
  }

  .ep-row.is-active {
    display: grid;
  }

  .ep-summary h3 {
    margin: 0 0 0.35rem;
    font-size: 1.04rem;
    font-weight: 600;
    color: #f1f5f9;
    letter-spacing: -0.015em;
  }

  .ep-sync {
    font-family: var(--font-mono);
    font-size: 0.77rem;
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .ep-src-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.73rem;
    margin-bottom: 0.4rem;
  }

  .ep-src-links a {
    color: #94a3b8;
    text-decoration: underline;
    text-decoration-color: rgba(148, 163, 184, 0.35);
    text-underline-offset: 2px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .ep-src-links a:hover {
    color: #f1f5f9;
    text-decoration-color: #f1f5f9;
  }

  .ep-sep {
    color: #475569;
  }

  .ep-src pre {
    margin: 0;
    padding: 0.65rem 0.85rem;
    border-left: 2px solid #2c3545;
    background: rgba(13, 17, 24, 0.55);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.58;
    color: #94a3b8;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .ep-data-title {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #94a3b8;
    margin-bottom: 0.45rem;
  }

  .ep-data pre {
    margin: 0;
    padding: 0.9rem 1.05rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 3px;
    background: #0a0e15;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.62;
    color: #e2e8f0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  @media (max-width: 860px) {
    .ep-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>

<script>
  const root = document.getElementById('exec-path');
  if (root) {
    const nodes = Array.from(root.querySelectorAll('.ep-node'));
    const cols = Array.from(root.querySelectorAll('.col-bg'));
    const beams = Array.from(root.querySelectorAll('.flow-beam'));
    const asyncPulses = Array.from(root.querySelectorAll('.async-pulse'));
    const panels = Array.from(root.querySelectorAll('.ep-row'));
    const counter = document.getElementById('ep-counter');
    const prevBtn = document.getElementById('ep-prev');
    const nextBtn = document.getElementById('ep-next');
    const playBtn = document.getElementById('ep-play');

    const elT1 = document.getElementById('live-t1');
    const elBar = document.getElementById('live-bar');
    const elT2 = document.getElementById('live-t2');
    const elT3 = document.getElementById('live-t3');
    const elAtom = document.getElementById('live-atom');
    const elT4 = document.getElementById('live-t4');
    const elT5 = document.getElementById('live-t5');
    const qSlots = [
      document.getElementById('q-s0'),
      document.getElementById('q-s1'),
      document.getElementById('q-s2'),
    ];

    // Map each of the 6 stages to its vertical column index (stages 1 & 2 share Col 1)
    const stageCols = [0, 1, 1, 2, 3, 4];

    const frames = [
      {
        t1: '100418.00 · 0.42 SELL',
        bar: '1m close 100418.00',
        t2: 'float[N] seq #408',
        t3: 'score 0.584',
        atom: '0.584',
        t4: 'HOLD (< 0.650)',
        t5: 'idle',
        qDepth: 1,
      },
      {
        t1: '100419.50 · 0.90 BUY',
        bar: '1m close 100419.50',
        t2: 'float[N] seq #409',
        t3: 'score 0.584',
        atom: '0.584',
        t4: 'HOLD (< 0.650)',
        t5: 'idle',
        qDepth: 2,
      },
      {
        t1: '100420.00 · 0.65 BUY',
        bar: '1m close 100420.00',
        t2: 'float[N] seq #410',
        t3: 'score 0.641',
        atom: '0.641',
        t4: 'HOLD (< 0.650)',
        t5: 'idle',
        qDepth: 3,
      },
      {
        t1: '100420.50 · 1.85 BUY',
        bar: '1m close 100420.50',
        t2: 'float[N] seq #411',
        t3: 'score 0.712',
        atom: '0.712',
        t4: 'BUY 0.01 VALID',
        t5: 'on_create_order',
        qDepth: 2,
      },
      {
        t1: '100421.00 · 0.30 BUY',
        bar: '1m close 100421.00',
        t2: 'float[N] seq #412',
        t3: 'score 0.712',
        atom: '0.712',
        t4: 'BUY 0.01 VALID',
        t5: 'SUBMITTED',
        qDepth: 1,
      },
    ];

    let current = 0;
    let frameIdx = 3;
    let timer = null;

    function applyFrame(fi) {
      const f = frames[fi % frames.length];
      if (elT1) elT1.textContent = f.t1;
      if (elBar) elBar.textContent = f.bar;
      if (elT2) elT2.textContent = f.t2;
      if (elT3) elT3.textContent = f.t3;
      if (elAtom) elAtom.textContent = f.atom;
      if (elT4) elT4.textContent = f.t4;
      if (elT5) elT5.textContent = f.t5;
      qSlots.forEach((slot, i) => {
        if (!slot) return;
        const filled = i < f.qDepth;
        slot.setAttribute('fill', filled ? '#60a5fa' : '#1e293b');
        slot.setAttribute('opacity', filled ? (i === 0 ? '1' : '0.65') : '1');
      });
    }

    function setStep(idx) {
      current = (idx + nodes.length) % nodes.length;
      root.dataset.step = String(current);
      if (counter) counter.textContent = `Stage ${current + 1} / ${nodes.length}`;

      const activeCol = stageCols[current];
      cols.forEach((c, i) => c.classList.toggle('is-active', i === activeCol));
      nodes.forEach((n, i) => n.classList.toggle('is-active', i === current));

      // Activate beams corresponding to the active stage
      const beamMap = {
        0: [0, 1],
        1: [0, 2],
        2: [1, 3],
        3: [2, 3],
        4: [4],
        5: [5],
      };
      const activeBeams = beamMap[current] || [];
      beams.forEach((b, i) => b.classList.toggle('is-active', activeBeams.includes(i)));
      asyncPulses.forEach((p) => p.classList.toggle('is-active', current === 1 || current === 4));
      panels.forEach((p, i) => p.classList.toggle('is-active', i === current));
    }

    function stopAuto() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
      root.classList.add('is-paused');
      playBtn?.classList.remove('is-playing');
      if (playBtn) playBtn.textContent = 'Play';
    }

    function startAuto() {
      if (timer !== null) return;
      root.classList.remove('is-paused');
      playBtn?.classList.add('is-playing');
      if (playBtn) playBtn.textContent = 'Pause';
      timer = window.setInterval(() => {
        frameIdx = (frameIdx + 1) % frames.length;
        applyFrame(frameIdx);
        setStep(current + 1);
      }, 2200);
    }

    applyFrame(frameIdx);
    setStep(0);

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      stopAuto();
    } else {
      startAuto();
    }

    prevBtn?.addEventListener('click', () => {
      stopAuto();
      setStep(current - 1);
    });
    nextBtn?.addEventListener('click', () => {
      stopAuto();
      setStep(current + 1);
    });
    playBtn?.addEventListener('click', () => {
      if (timer !== null) stopAuto();
      else startAuto();
    });

    nodes.forEach((node, idx) => {
      node.addEventListener('click', () => {
        stopAuto();
        applyFrame(3);
        setStep(idx);
      });
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          stopAuto();
          applyFrame(3);
          setStep(idx);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          stopAuto();
          setStep(idx + 1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          stopAuto();
          setStep(idx - 1);
        }
      });
    });
  }
</script>
