---
const steps = [
  {
    idx: 0,
    col: 0,
    headline: 'Socket thread parses raw wire JSON via simdjson & enqueues lock-free',
    sync: 'NormalizedParsedTrade::from_simdjson() → live_event_queue_',
    dataTitle: 'Raw Binance Futures Wire Frame (btcusdt@trade)',
    data: `{
  "e": "trade",
  "E": 1732632012418,
  "T": 1732632012416,
  "s": "BTCUSDT",
  "t": 5481920411,
  "p": "100420.50",
  "q": "1.85",
  "m": false
}`,
    sourceRef: 'normalized_trade.cpp:59 · state_updater.cpp:936',
    code: `auto trade = NormalizedParsedTrade::from_simdjson(el, "binance", "swap");
live_event_queue_.enqueue(std::move(event));`,
  },
  {
    idx: 1,
    col: 1,
    headline: 'Consumer updates order book & fans out asynchronously',
    sync: 'RingBufferBook (~1.5 ns/op) + StateMachineDispatcher::enqueue()',
    dataTitle: 'Concurrent Fan-out',
    data: `book.apply_bid(tick_idx, qty)       // ~1.5 ns/op (Core Ultra 9 285K)
engine.update_price("BTCUSDT", px)  // visible to Strategy Pool immediately
sm_dispatcher.enqueue(event)        // lock-free handoff to SM thread`,
    sourceRef: 'state_updater.cpp:4070, 4221',
    code: `live_event_queue_.wait_dequeue_timed(event, ...);
StateMachineDispatcher::get_instance().enqueue(MarketEvent(event));`,
  },
  {
    idx: 2,
    col: 2,
    headline: 'Dedicated SM thread updates rolling C++ feature state',
    sync: 'Versioned lock-free machine snapshot · shared offline & live C++',
    dataTitle: 'WindowedTakerFlowSM::emit_state()',
    data: `bucket[ts_sec % 3600].buy_volume += 100420.50 * 1.85
emit_state() -> float[5] {
  buy_ratio_5s:       0.780f,
  trade_count_5s:     14.0f,
  buy_volume_5s:      185778.0f,
  sell_volume_5s:     52400.0f,
  vol_ratio_5s_30s:   0.412f
}`,
    sourceRef: 'state_machine_dispatcher.cpp:64 · windowed_taker_flow_sm.cpp:65',
    code: `for (auto& sm : snapshot) sm->react(event);`,
  },
  {
    idx: 3,
    col: 3,
    headline: 'Worker pool scores ONNX in-process & stores atomic signal',
    sync: 'In-flight guarded pool (hardware_concurrency) → atomic_signal_main',
    dataTitle: 'OnnxModel::predict() → AtomicSignal',
    data: `model:              "taker_flow_v1.onnx"  (in-process C++ session)
input_tensor:       float[1, 5]
predicted_score:    0.712f  (> 0.650f entry threshold)
atomic_signal_main: store(0.712f, 1732632012418)`,
    sourceRef: 'engine.cpp:728 · binance_onnx_perp.cpp:34',
    code: `float score = model->predict(*features);
ticker->atomic_signal_main.store(score, now_ms);`,
  },
  {
    idx: 4,
    col: 4,
    headline: 'Strategy pool checks risk gates & dispatches order',
    sync: 'ticker->trading_mutex → construct_order() → TradeTicker seam',
    dataTitle: 'Core::Order Posted (<1 ms end-to-end)',
    data: `risk_gate:  trading_mutex LOCKED · quotes_pulled=false · caps=PASS
order:      { symbol: "BTCUSDT", side: BUY, type: MARKET, qty: "0.01" }
dispatch:   LiveTradeTicker -> Direct Sign | cpp_live_proxy | PaperExchange`,
    sourceRef: 'engine.cpp:871 · binance_onnx_perp.cpp:57',
    code: `std::lock_guard lock(ticker->trading_mutex);
auto [score, ts] = ticker->atomic_signal_main.load();
Core::StrategyHelpers::submit_market_order(..., decision);`,
  },
];
---

<div class="ep" id="exec-path" data-step="0">
  <!-- Understated top bar: legend left, quiet controls right -->
  <div class="ep-top">
    <div class="ep-legend" aria-label="Diagram key">
      <span><i class="dot dot-comp"></i>Active compute</span>
      <span><i class="dot dot-queue"></i>Lock-free queue</span>
      <span><i class="dot dot-atom"></i>Atomic handoff</span>
    </div>
    <div class="ep-ctrl">
      <span class="ep-step-num" id="ep-counter">1 / 5</span>
      <button type="button" class="ep-btn" id="ep-prev" aria-label="Previous stage">←</button>
      <button type="button" class="ep-btn" id="ep-next" aria-label="Next stage">→</button>
      <button type="button" class="ep-btn ep-play" id="ep-play">Play</button>
    </div>
  </div>

  <!-- Large, open 5-column vertical thread-swimlane illustration -->
  <div class="ep-stage">
    <svg
      viewBox="0 0 1120 350"
      role="img"
      aria-label="Vertical thread swimlane illustration showing asynchronous left-to-right propagation from WebSocket I/O through lock-free queues, streaming C++ features, in-process ONNX inference, atomic signal handoff, and strategy order execution"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <marker id="arr-muted" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#475569" />
        </marker>
        <marker id="arr-queue" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#60a5fa" />
        </marker>
        <marker id="arr-atom" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#d4a359" />
        </marker>
      </defs>

      <!-- 5 Vertical Thread Swimlane Columns -->
      <rect class="col-bg" data-col="0" x="0" y="0" width="216" height="350" fill="transparent" />
      <rect class="col-bg" data-col="1" x="224" y="0" width="216" height="350" fill="transparent" />
      <rect class="col-bg" data-col="2" x="448" y="0" width="216" height="350" fill="transparent" />
      <rect class="col-bg" data-col="3" x="672" y="0" width="216" height="350" fill="transparent" />
      <rect class="col-bg" data-col="4" x="896" y="0" width="224" height="350" fill="transparent" />

      <!-- Vertical thread boundary hairlines -->
      <line x1="220" y1="12" x2="220" y2="338" stroke="#1e2532" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="444" y1="12" x2="444" y2="338" stroke="#1e2532" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="668" y1="12" x2="668" y2="338" stroke="#1e2532" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="892" y1="12" x2="892" y2="338" stroke="#1e2532" stroke-width="1" stroke-dasharray="3 4" />

      <!-- Thread Column Headers -->
      <text x="16" y="28" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T1 · WS I/O</text>
      <text x="16" y="45" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="10">MarketDataStreams</text>

      <text x="240" y="28" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T2 · Event Consumer</text>
      <text x="240" y="45" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="10">live_event_consumer_loop</text>

      <text x="464" y="28" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T3 · Feature SM</text>
      <text x="464" y="45" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="10">StateMachineDispatcher</text>

      <text x="688" y="28" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T4 · ONNX Pool</text>
      <text x="688" y="45" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="10">predictions_thread_pool</text>

      <text x="912" y="28" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T5 · Strategy Pool</text>
      <text x="912" y="45" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="10">strategy_thread_pool</text>

      <!-- CONCURRENT UPPER BYPASS: Book / Price state flows asynchronously directly from T2 -> T5 -->
      <path class="async-rail" d="M 332 136 L 332 92 L 1008 92 L 1008 134" fill="none" stroke="#263142" stroke-width="1.4" />
      <path class="async-pulse" d="M 332 136 L 332 92 L 1008 92 L 1008 134" fill="none" stroke="#94a3b8" stroke-width="1.6" marker-end="url(#arr-muted)" />
      <text x="668" y="83" text-anchor="middle" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="9.5">
        book &amp; spot state readable concurrently (async from ML path)
      </text>

      <!-- MAIN LEFT-TO-RIGHT HANDOFF RAILS -->
      <!-- Handoff 0->1: Lock-free Queue -->
      <line class="handoff q-edge" data-edge="0" x1="194" y1="184" x2="246" y2="184" stroke="#334155" stroke-width="1.8" marker-end="url(#arr-queue)" />
      <line class="flow-beam flow-q" data-beam="0" x1="194" y1="184" x2="242" y2="184" stroke="#60a5fa" stroke-width="2" />
      <text x="220" y="218" text-anchor="middle" fill="#60a5fa" font-family="IBM Plex Mono, monospace" font-size="9">live_event_queue_</text>
      <text x="220" y="232" text-anchor="middle" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="8.5">lock-free MPSC</text>

      <!-- Handoff 1->2: Lock-free Queue -->
      <line class="handoff q-edge" data-edge="1" x1="418" y1="184" x2="470" y2="184" stroke="#334155" stroke-width="1.8" marker-end="url(#arr-queue)" />
      <line class="flow-beam flow-q" data-beam="1" x1="418" y1="184" x2="466" y2="184" stroke="#60a5fa" stroke-width="2" />
      <text x="444" y="218" text-anchor="middle" fill="#60a5fa" font-family="IBM Plex Mono, monospace" font-size="9">sm_queue_</text>
      <text x="444" y="232" text-anchor="middle" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="8.5">lock-free fan-out</text>

      <!-- Handoff 2->3: Feature Vector Read -->
      <line class="handoff c-edge" data-edge="2" x1="642" y1="184" x2="694" y2="184" stroke="#334155" stroke-width="1.8" marker-end="url(#arr-muted)" />
      <line class="flow-beam flow-c" data-beam="2" x1="642" y1="184" x2="690" y2="184" stroke="#cbd5e1" stroke-width="2" />
      <text x="668" y="218" text-anchor="middle" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="9">emit_state()</text>
      <text x="668" y="232" text-anchor="middle" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="8.5">float[N]</text>

      <!-- Handoff 3->4: Atomic Store/Load -->
      <line class="handoff a-edge" data-edge="3" x1="866" y1="184" x2="918" y2="184" stroke="#334155" stroke-width="1.8" marker-end="url(#arr-atom)" />
      <line class="flow-beam flow-a" data-beam="3" x1="866" y1="184" x2="914" y2="184" stroke="#d4a359" stroke-width="2.2" />
      <text x="892" y="218" text-anchor="middle" fill="#d4a359" font-family="IBM Plex Mono, monospace" font-size="9">atomic_signal</text>
      <text x="892" y="232" text-anchor="middle" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="8.5">lock-free store/load</text>

      <!-- STAGE NODES (Large, clean, clickable) -->
      <!-- Node 0 -->
      <g class="ep-node is-active" data-node="0" role="button" tabindex="0" aria-label="Stage 1: Parse wire frame">
        <rect x="20" y="138" width="174" height="92" rx="3" fill="#0d1118" stroke="#2c3545" stroke-width="1.3" />
        <text x="34" y="164" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="10">01 · INGEST</text>
        <text x="34" y="186" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">Parse Tick</text>
        <text x="34" y="208" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10">MarketEvent::TRADE</text>
      </g>

      <!-- Node 1 -->
      <g class="ep-node" data-node="1" role="button" tabindex="0" aria-label="Stage 2: Update order book and fan out">
        <rect x="246" y="138" width="172" height="92" rx="3" fill="#0d1118" stroke="#2c3545" stroke-width="1.3" />
        <text x="260" y="164" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="10">02 · STATE</text>
        <text x="260" y="186" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">RingBufferBook</text>
        <text x="260" y="208" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10">~1.5 ns/op apply_bid</text>
      </g>

      <!-- Node 2 -->
      <g class="ep-node" data-node="2" role="button" tabindex="0" aria-label="Stage 3: Streaming feature state machine">
        <rect x="470" y="138" width="172" height="92" rx="3" fill="#0d1118" stroke="#2c3545" stroke-width="1.3" />
        <text x="484" y="164" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="10">03 · FEATURES</text>
        <text x="484" y="186" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">SM::react()</text>
        <text x="484" y="208" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10">Shared offline/live</text>
      </g>

      <!-- Node 3 -->
      <g class="ep-node" data-node="3" role="button" tabindex="0" aria-label="Stage 4: In-process ONNX inference">
        <rect x="694" y="138" width="172" height="92" rx="3" fill="#0d1118" stroke="#2c3545" stroke-width="1.3" />
        <text x="708" y="164" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="10">04 · INFERENCE</text>
        <text x="708" y="186" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">ONNX Runtime</text>
        <text x="708" y="208" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10">In-process C++</text>
      </g>

      <!-- Node 4 -->
      <g class="ep-node" data-node="4" role="button" tabindex="0" aria-label="Stage 5: Strategy decision, risk gate, and order dispatch">
        <rect x="918" y="138" width="182" height="92" rx="3" fill="#0d1118" stroke="#2c3545" stroke-width="1.3" />
        <text x="932" y="164" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="10">05 · EXECUTION</text>
        <text x="932" y="186" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">Risk &amp; Order</text>
        <text x="932" y="208" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10">Direct · Proxy · Paper</text>
      </g>

      <!-- Bottom subtle end-to-end latency bracket -->
      <path d="M 20 278 L 20 292 L 1100 292 L 1100 278" fill="none" stroke="#263142" stroke-width="1.2" />
      <text x="560" y="314" text-anchor="middle" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">
        &lt;1 ms end-to-end tick → features → inference → order · no cross-thread blocking on socket I/O
      </text>
    </svg>
  </div>

  <!-- Clean, low-chrome inspector below the illustration -->
  <div class="ep-inspector">
    {steps.map((s) => (
      <div class={`ep-row ${s.idx === 0 ? 'is-active' : ''}`} data-panel={s.idx}>
        <div class="ep-summary">
          <h3>{s.headline}</h3>
          <div class="ep-sync">{s.sync}</div>
          <div class="ep-src">
            <span class="ep-src-ref">{s.sourceRef}</span>
            <pre><code>{s.code}</code></pre>
          </div>
        </div>
        <div class="ep-data">
          <div class="ep-data-title">{s.dataTitle}</div>
          <pre><code>{s.data}</code></pre>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .ep {
    margin-top: 0.5rem;
  }

  .ep-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  }

  .ep-legend {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #94a3b8;
  }

  .ep-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-comp {
    background: #f1f5f9;
  }

  .dot-queue {
    background: #60a5fa;
  }

  .dot-atom {
    background: #d4a359;
  }

  .ep-ctrl {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .ep-step-num {
    color: #64748b;
    margin-right: 0.35rem;
  }

  .ep-btn {
    appearance: none;
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #cbd5e1;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.26rem 0.62rem;
    border-radius: 3px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .ep-btn:hover {
    border-color: #94a3b8;
    color: #ffffff;
  }

  .ep-btn:focus-visible,
  .ep-node:focus-visible {
    outline: 2px solid #f1f5f9;
    outline-offset: 2px;
  }

  .ep-play.is-playing {
    border-color: #d4a359;
    color: #f3d092;
  }

  /* Open SVG stage — no boxed debug container */
  .ep-stage {
    padding: 1.25rem 0 0.5rem;
    overflow-x: auto;
  }

  .ep-stage svg {
    display: block;
    width: 100%;
    min-width: 820px;
    height: auto;
  }

  .col-bg {
    transition: fill 0.22s ease;
  }

  .col-bg.is-active {
    fill: rgba(241, 245, 249, 0.03);
  }

  .ep-node {
    cursor: pointer;
  }

  .ep-node rect {
    transition: stroke 0.2s ease, fill 0.2s ease;
  }

  .ep-node:hover rect {
    stroke: #64748b;
  }

  .ep-node.is-done rect {
    stroke: #475569;
    fill: #0f141e;
  }

  .ep-node.is-active rect {
    stroke: #f1f5f9;
    fill: #131926;
    stroke-width: 1.8;
  }

  /* Asynchronous concurrent pulses */
  .async-pulse,
  .flow-beam {
    stroke-dasharray: 6 12;
    opacity: 0.22;
    transition: opacity 0.2s ease;
  }

  .flow-beam.is-active {
    opacity: 1;
  }

  .async-pulse.is-active {
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ep:not(.is-paused) .async-pulse {
      animation: epFlow 2.2s linear infinite;
    }
    .ep:not(.is-paused) .flow-beam.is-active {
      animation: epFlow 0.9s linear infinite;
    }
  }

  @keyframes epFlow {
    from {
      stroke-dashoffset: 36;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Quiet, border-minimal bottom inspector */
  .ep-inspector {
    margin-top: 0.75rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(148, 163, 184, 0.14);
  }

  .ep-row {
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 2.5rem;
    align-items: start;
  }

  .ep-row.is-active {
    display: grid;
  }

  .ep-summary h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: #f1f5f9;
    letter-spacing: -0.015em;
  }

  .ep-sync {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .ep-src {
    opacity: 0.82;
  }

  .ep-src-ref {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.71rem;
    color: #64748b;
    margin-bottom: 0.35rem;
  }

  .ep-src pre {
    margin: 0;
    padding: 0.65rem 0.85rem;
    border-left: 2px solid #2c3545;
    background: rgba(13, 17, 24, 0.65);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.55;
    color: #94a3b8;
    overflow-x: auto;
  }

  .ep-data-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #94a3b8;
    margin-bottom: 0.45rem;
  }

  .ep-data pre {
    margin: 0;
    padding: 0.9rem 1.05rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 3px;
    background: #0a0e15;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.62;
    color: #e2e8f0;
    overflow-x: auto;
  }

  @media (max-width: 860px) {
    .ep-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>

<script>
  const root = document.getElementById('exec-path');
  if (root) {
    const nodes = Array.from(root.querySelectorAll('.ep-node'));
    const cols = Array.from(root.querySelectorAll('.col-bg'));
    const beams = Array.from(root.querySelectorAll('.flow-beam'));
    const asyncPulse = root.querySelector('.async-pulse');
    const panels = Array.from(root.querySelectorAll('.ep-row'));
    const counter = document.getElementById('ep-counter');
    const prevBtn = document.getElementById('ep-prev');
    const nextBtn = document.getElementById('ep-next');
    const playBtn = document.getElementById('ep-play');

    let current = 0;
    let timer = null;

    function setStep(idx) {
      current = (idx + nodes.length) % nodes.length;
      root.dataset.step = String(current);
      if (counter) counter.textContent = `${current + 1} / ${nodes.length}`;

      cols.forEach((c, i) => c.classList.toggle('is-active', i === current));
      nodes.forEach((n, i) => {
        n.classList.toggle('is-active', i === current);
        n.classList.toggle('is-done', i < current);
      });
      beams.forEach((b, i) => {
        b.classList.toggle('is-active', i === current - 1 || (current === 0 && i === 0));
      });
      asyncPulse?.classList.toggle('is-active', current >= 1);
      panels.forEach((p, i) => p.classList.toggle('is-active', i === current));
    }

    function stopAuto() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
      playBtn?.classList.remove('is-playing');
      if (playBtn) playBtn.textContent = 'Play';
    }

    function toggleAuto() {
      if (timer !== null) {
        stopAuto();
        return;
      }
      playBtn?.classList.add('is-playing');
      if (playBtn) playBtn.textContent = 'Pause';
      timer = window.setInterval(() => setStep(current + 1), 2800);
    }

    setStep(0);

    prevBtn?.addEventListener('click', () => {
      stopAuto();
      setStep(current - 1);
    });
    nextBtn?.addEventListener('click', () => {
      stopAuto();
      setStep(current + 1);
    });
    playBtn?.addEventListener('click', toggleAuto);

    nodes.forEach((node, idx) => {
      node.addEventListener('click', () => {
        stopAuto();
        setStep(idx);
      });
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          stopAuto();
          setStep(idx);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          stopAuto();
          setStep(idx + 1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          stopAuto();
          setStep(idx - 1);
        }
      });
    });
  }
</script>
