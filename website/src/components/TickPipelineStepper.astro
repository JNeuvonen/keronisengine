---
const steps = [
  {
    idx: 0,
    col: 0,
    headline: 'Socket thread parses raw wire JSON via simdjson & enqueues lock-free',
    sync: 'NormalizedParsedTrade::from_simdjson() → live_event_queue_',
    dataTitle: 'Raw Binance Futures Wire Frame (btcusdt@trade)',
    data: `{
  "e": "trade",
  "E": 1732632012418,
  "T": 1732632012416,
  "s": "BTCUSDT",
  "t": 5481920411,
  "p": "100420.50",
  "q": "1.85",
  "m": false
}`,
    sourceRef: 'normalized_trade.cpp:59 · state_updater.cpp:936',
    code: `auto t = NormalizedParsedTrade::from_simdjson(
    el, "binance", "swap");
live_event_queue_.enqueue(std::move(event));`,
  },
  {
    idx: 1,
    col: 1,
    headline: 'Consumer updates order book & fans out asynchronously',
    sync: 'RingBufferBook (~1.5 ns/op) + StateMachineDispatcher::enqueue()',
    dataTitle: 'Normalized State & Concurrent Fan-out',
    data: `book.apply_bid(tick_idx, qty)      // ~1.5 ns/op (285K)
engine.update_price("BTCUSDT", px) // readable by T5 now
sm_dispatcher.enqueue(event)       // non-blocking MPSC`,
    sourceRef: 'state_updater.cpp:4070, 4221',
    code: `live_event_queue_.wait_dequeue_timed(event, ...);
StateMachineDispatcher::get_instance()
    .enqueue(MarketEvent(event));`,
  },
  {
    idx: 2,
    col: 2,
    headline: 'Dedicated SM thread updates rolling C++ feature state',
    sync: 'Versioned lock-free machine snapshot · shared offline & live C++',
    dataTitle: 'WindowedTakerFlowSM::emit_state()',
    data: `bucket[ts_sec % 3600].buy_volume += 100420.50 * 1.85
emit_state() -> float[5] {
  buy_ratio_5s:     0.780f,
  trade_count_5s:   14.0f,
  buy_volume_5s:    185778.0f,
  sell_volume_5s:   52400.0f,
  vol_ratio_5s_30s: 0.412f
}`,
    sourceRef: 'state_machine_dispatcher.cpp:64 · windowed_taker_flow_sm.cpp:65',
    code: `for (auto& sm : snapshot) {
    sm->react(event);
}`,
  },
  {
    idx: 3,
    col: 3,
    headline: 'Async worker pool scores ONNX & updates atomic_signal_main',
    sync: 'In-flight guarded pool (not 1:1 per tick) → atomic store',
    dataTitle: 'OnnxModel::predict() → AtomicSignal',
    data: `model:              "taker_flow_v1.onnx" (C++ session)
input_tensor:       float[1, 5]
predicted_score:    0.712f  (> 0.650f entry threshold)
atomic_signal_main: store(0.712f, 1732632012418)`,
    sourceRef: 'engine.cpp:728 · binance_onnx_perp.cpp:34',
    code: `float score = model->predict(*features);
ticker->atomic_signal_main.store(score, now_ms);`,
  },
  {
    idx: 4,
    col: 4,
    headline: 'Strategy pool reads latest book + atomic signal & posts order',
    sync: 'ticker->trading_mutex → construct_order() → TradeTicker seam',
    dataTitle: 'Core::Order Posted (<1 ms end-to-end)',
    data: `risk_gate:  trading_mutex · quotes_pulled=false · PASS
order:      { symbol: "BTCUSDT", side: BUY, qty: "0.01" }
dispatch:   Direct Sign | cpp_live_proxy | PaperExchange`,
    sourceRef: 'engine.cpp:871 · binance_onnx_perp.cpp:57',
    code: `std::lock_guard lock(ticker->trading_mutex);
auto [score, ts] = ticker->atomic_signal_main.load();
StrategyHelpers::submit_market_order(..., decision);`,
  },
];
---

<div class="ep" id="exec-path" data-step="0">
  <div class="ep-top">
    <div class="ep-legend" aria-label="Diagram key">
      <span><i class="dot dot-comp"></i>Active compute</span>
      <span><i class="dot dot-queue"></i>Lock-free queue</span>
      <span><i class="dot dot-atom"></i>Atomic register</span>
    </div>
    <div class="ep-ctrl">
      <span class="ep-step-num" id="ep-counter">Stage 1 / 5</span>
      <button type="button" class="ep-btn" id="ep-prev" aria-label="Previous stage">←</button>
      <button type="button" class="ep-btn" id="ep-next" aria-label="Next stage">→</button>
      <button type="button" class="ep-btn ep-play" id="ep-play">Pause</button>
    </div>
  </div>

  <!-- Spacious 5-column vertical thread-swimlane illustration with live computational values -->
  <div class="ep-stage">
    <svg
      viewBox="0 0 1180 390"
      role="img"
      aria-label="Vertical thread swimlane visualization showing concurrent asynchronous event propagation from raw Binance trade ticks through lock-free queues, streaming C++ features, in-process ONNX inference, atomic signal register, and strategy execution"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <marker id="arr-muted" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#64748b" />
        </marker>
        <marker id="arr-queue" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#60a5fa" />
        </marker>
        <marker id="arr-atom" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#d4a359" />
        </marker>
      </defs>

      <!-- 5 Vertical Thread Swimlane Backgrounds -->
      <rect class="col-bg" data-col="0" x="0" y="0" width="206" height="340" fill="transparent" />
      <rect class="col-bg" data-col="1" x="242" y="0" width="206" height="340" fill="transparent" />
      <rect class="col-bg" data-col="2" x="484" y="0" width="206" height="340" fill="transparent" />
      <rect class="col-bg" data-col="3" x="726" y="0" width="206" height="340" fill="transparent" />
      <rect class="col-bg" data-col="4" x="968" y="0" width="212" height="340" fill="transparent" />

      <!-- Vertical thread boundary hairlines -->
      <line x1="224" y1="8" x2="224" y2="338" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="466" y1="8" x2="466" y2="338" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="708" y1="8" x2="708" y2="338" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="950" y1="8" x2="950" y2="338" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />

      <!-- Thread Column Headers -->
      <text x="14" y="26" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T1 · WS I/O</text>
      <text x="14" y="43" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">MarketDataStreams</text>

      <text x="256" y="26" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T2 · Event Consumer</text>
      <text x="256" y="43" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">live_event_consumer</text>

      <text x="498" y="26" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T3 · Feature SM</text>
      <text x="498" y="43" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">StateMachineDispatcher</text>

      <text x="740" y="26" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T4 · ONNX Pool</text>
      <text x="740" y="43" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">predictions_pool (async)</text>

      <text x="982" y="26" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T5 · Strategy Pool</text>
      <text x="982" y="43" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">strategy_pool (async)</text>

      <!-- CONCURRENT UPPER BYPASS: Book / Spot state readable asynchronously by T5 -->
      <path d="M 345 128 L 345 84 L 1072 84 L 1072 126" fill="none" stroke="#222c3c" stroke-width="1.4" />
      <path class="async-pulse" d="M 345 128 L 345 84 L 1072 84 L 1072 126" fill="none" stroke="#94a3b8" stroke-width="1.6" marker-end="url(#arr-muted)" />
      <text x="708" y="74" text-anchor="middle" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">
        live order book &amp; spot price readable concurrently (independent of ONNX cadence)
      </text>

      <!-- HANDOFF 1: T1 -> live_event_queue_ (Lock-free ring queue glyph) -> T2 -->
      <line x1="192" y1="184" x2="254" y2="184" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-queue)" />
      <line class="flow-beam" data-beam="0" x1="192" y1="184" x2="250" y2="184" stroke="#60a5fa" stroke-width="2" />
      <!-- Discrete Queue Buffer Slots -->
      <g class="q-glyph" data-q="0" transform="translate(206, 174)">
        <rect x="0" y="0" width="36" height="20" rx="2" fill="#0b1220" stroke="#60a5fa" stroke-opacity="0.7" stroke-width="1.2" />
        <rect class="q-slot" x="4" y="4" width="7" height="12" rx="1" fill="#60a5fa" />
        <rect class="q-slot" x="14" y="4" width="7" height="12" rx="1" fill="#60a5fa" opacity="0.55" />
        <rect class="q-slot" x="24" y="4" width="7" height="12" rx="1" fill="#1e293b" />
      </g>
      <text x="224" y="282" text-anchor="middle" fill="#60a5fa" font-family="IBM Plex Mono, monospace" font-size="10.5">live_event_queue_</text>
      <text x="224" y="297" text-anchor="middle" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">lock-free MPSC</text>

      <!-- HANDOFF 2: T2 -> sm_queue_ (Lock-free fan-out queue glyph) -> T3 -->
      <line x1="434" y1="184" x2="496" y2="184" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-queue)" />
      <line class="flow-beam" data-beam="1" x1="434" y1="184" x2="492" y2="184" stroke="#60a5fa" stroke-width="2" />
      <g class="q-glyph" data-q="1" transform="translate(448, 174)">
        <rect x="0" y="0" width="36" height="20" rx="2" fill="#0b1220" stroke="#60a5fa" stroke-opacity="0.7" stroke-width="1.2" />
        <rect class="q-slot" x="4" y="4" width="7" height="12" rx="1" fill="#60a5fa" />
        <rect class="q-slot" x="14" y="4" width="7" height="12" rx="1" fill="#60a5fa" opacity="0.4" />
        <rect class="q-slot" x="24" y="4" width="7" height="12" rx="1" fill="#1e293b" />
      </g>
      <text x="466" y="282" text-anchor="middle" fill="#60a5fa" font-family="IBM Plex Mono, monospace" font-size="10.5">sm_queue_</text>
      <text x="466" y="297" text-anchor="middle" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">async fan-out</text>

      <!-- HANDOFF 3: T3 -> emit_state() snapshot read -> T4 -->
      <line x1="676" y1="184" x2="738" y2="184" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-muted)" />
      <line class="flow-beam" data-beam="2" x1="676" y1="184" x2="734" y2="184" stroke="#cbd5e1" stroke-width="2" />
      <text x="708" y="282" text-anchor="middle" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">emit_state()</text>
      <text x="708" y="297" text-anchor="middle" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">float[5] snapshot</text>

      <!-- HANDOFF 4: T4 -> atomic_signal_main (Atomic register glyph) -> T5 -->
      <line x1="918" y1="184" x2="980" y2="184" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-atom)" />
      <line class="flow-beam" data-beam="3" x1="918" y1="184" x2="976" y2="184" stroke="#d4a359" stroke-width="2.2" />
      <!-- Atomic Memory Register Cell -->
      <g class="atom-glyph" id="atom-reg" transform="translate(925, 171)">
        <rect x="0" y="0" width="50" height="26" rx="2" fill="#15120b" stroke="#d4a359" stroke-width="1.3" />
        <text id="live-atom" x="25" y="17" text-anchor="middle" fill="#f3d092" font-family="IBM Plex Mono, monospace" font-size="10" font-weight="600">0.712</text>
      </g>
      <text x="950" y="282" text-anchor="middle" fill="#d4a359" font-family="IBM Plex Mono, monospace" font-size="10.5">atomic_signal</text>
      <text x="950" y="297" text-anchor="middle" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">store / load</text>

      <!-- STAGE NODES WITH LIVE COMPUTATIONAL READOUTS -->
      <!-- Node 0: T1 WS I/O -->
      <g class="ep-node is-active" data-node="0" role="button" tabindex="0" aria-label="Stage 1: Parse raw wire tick">
        <rect x="14" y="130" width="178" height="114" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="26" y="152" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">01 · RAW WIRE (simdjson)</text>
        <text x="26" y="174" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="13.5" font-weight="600">btcusdt@trade</text>
        <text id="live-t1-px" x="26" y="198" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">"p":"100420.50"</text>
        <text id="live-t1-qty" x="26" y="216" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">"q":"1.85" "m":false</text>
        <text id="live-t1-id" x="26" y="232" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="9.5">t=5481920411</text>
      </g>

      <!-- Node 1: T2 Book & Fan-out -->
      <g class="ep-node" data-node="1" role="button" tabindex="0" aria-label="Stage 2: Update order book and fan out">
        <rect x="256" y="130" width="178" height="114" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="268" y="152" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">02 · MARKET STATE</text>
        <text x="268" y="174" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="13.5" font-weight="600">RingBufferBook</text>
        <text id="live-t2-bba" x="268" y="198" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">last  100420.50</text>
        <text id="live-t2-side" x="268" y="216" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">taker BUY $185.8k</text>
        <text x="268" y="232" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="9.5">apply_bid ~1.5 ns/op</text>
      </g>

      <!-- Node 2: T3 Feature SM -->
      <g class="ep-node" data-node="2" role="button" tabindex="0" aria-label="Stage 3: Streaming feature state machine">
        <rect x="498" y="130" width="178" height="114" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="510" y="152" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">03 · FEATURES (C++)</text>
        <text x="510" y="174" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="13.5" font-weight="600">WindowedTakerFlow</text>
        <text id="live-t3-ratio" x="510" y="198" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">buy_ratio_5s  0.780</text>
        <text id="live-t3-cnt" x="510" y="216" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">trades_5s     14</text>
        <text x="510" y="232" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="9.5">shared offline/live</text>
      </g>

      <!-- Node 3: T4 ONNX Pool -->
      <g class="ep-node" data-node="3" role="button" tabindex="0" aria-label="Stage 4: In-process ONNX inference">
        <rect x="740" y="130" width="178" height="114" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="752" y="152" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">04 · INFERENCE</text>
        <text x="752" y="174" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="13.5" font-weight="600">ONNX Runtime</text>
        <text id="live-t4-score" x="752" y="198" fill="#f3d092" font-family="IBM Plex Mono, monospace" font-size="10.5">score  0.712f</text>
        <text id="live-t4-gate" x="752" y="216" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">enter  &gt; 0.650f</text>
        <text x="752" y="232" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="9.5">in-flight guarded</text>
      </g>

      <!-- Node 4: T5 Strategy & Risk -->
      <g class="ep-node" data-node="4" role="button" tabindex="0" aria-label="Stage 5: Strategy decision, risk gate, and order dispatch">
        <rect x="982" y="130" width="184" height="114" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="994" y="152" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">05 · RISK &amp; ORDER</text>
        <text x="994" y="174" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="13.5" font-weight="600">construct_order()</text>
        <text id="live-t5-act" x="994" y="198" fill="#f1f5f9" font-family="IBM Plex Mono, monospace" font-size="10.5">BUY 0.01 MARKET</text>
        <text id="live-t5-risk" x="994" y="216" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">caps · rate · holds</text>
        <text x="994" y="232" fill="#64748b" font-family="IBM Plex Mono, monospace" font-size="9.5">Direct · Proxy · Paper</text>
      </g>

      <!-- Bottom bracket: honest end-to-end latency + async note -->
      <path d="M 14 336 L 14 348 L 1166 348 L 1166 336" fill="none" stroke="#222c3c" stroke-width="1.2" />
      <text x="590" y="370" text-anchor="middle" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">
        &lt;1 ms tick → features → inference → order · T4 (ONNX) and T5 (Strategy) poll latest state asynchronously
      </text>
    </svg>
  </div>

  <!-- Quiet, low-chrome data & source inspector -->
  <div class="ep-inspector">
    {steps.map((s) => (
      <div class={`ep-row ${s.idx === 0 ? 'is-active' : ''}`} data-panel={s.idx}>
        <div class="ep-summary">
          <h3>{s.headline}</h3>
          <div class="ep-sync">{s.sync}</div>
          <div class="ep-src">
            <span class="ep-src-ref">{s.sourceRef}</span>
            <pre><code>{s.code}</code></pre>
          </div>
        </div>
        <div class="ep-data">
          <div class="ep-data-title">{s.dataTitle}</div>
          <pre><code>{s.data}</code></pre>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .ep {
    margin-top: 0.5rem;
  }

  .ep-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  }

  .ep-legend {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .ep-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-comp {
    background: #f1f5f9;
  }

  .dot-queue {
    background: #60a5fa;
  }

  .dot-atom {
    background: #d4a359;
  }

  .ep-ctrl {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .ep-step-num {
    color: #8b96a8;
    margin-right: 0.4rem;
  }

  .ep-btn {
    appearance: none;
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #cbd5e1;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.24rem 0.6rem;
    border-radius: 3px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .ep-btn:hover {
    border-color: #94a3b8;
    color: #ffffff;
  }

  .ep-btn:focus-visible,
  .ep-node:focus-visible {
    outline: 2px solid #f1f5f9;
    outline-offset: 2px;
  }

  .ep-play.is-playing {
    border-color: rgba(212, 163, 89, 0.65);
    color: #f3d092;
  }

  .ep-stage {
    padding: 1.2rem 0 0.4rem;
    overflow-x: auto;
  }

  .ep-stage svg {
    display: block;
    width: 100%;
    min-width: 860px;
    height: auto;
  }

  .col-bg {
    transition: fill 0.22s ease;
  }

  .col-bg.is-active {
    fill: rgba(241, 245, 249, 0.028);
  }

  .ep-node {
    cursor: pointer;
  }

  .ep-node rect {
    transition: stroke 0.2s ease, fill 0.2s ease;
  }

  .ep-node:hover rect {
    stroke: rgba(148, 163, 184, 0.45);
  }

  .ep-node.is-active rect {
    stroke: #f1f5f9;
    fill: #111722;
    stroke-width: 1.6;
  }

  .async-pulse,
  .flow-beam {
    stroke-dasharray: 6 12;
    opacity: 0.22;
    transition: opacity 0.2s ease;
  }

  .flow-beam.is-active {
    opacity: 0.95;
  }

  .async-pulse.is-active {
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ep:not(.is-paused) .async-pulse {
      animation: epFlow 2.4s linear infinite;
    }
    .ep:not(.is-paused) .flow-beam.is-active {
      animation: epFlow 0.95s linear infinite;
    }
  }

  @keyframes epFlow {
    from {
      stroke-dashoffset: 36;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Quiet inspector below the SVG */
  .ep-inspector {
    margin-top: 0.6rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(148, 163, 184, 0.14);
  }

  .ep-row {
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    gap: 2.25rem;
    align-items: start;
  }

  .ep-row.is-active {
    display: grid;
  }

  .ep-summary h3 {
    margin: 0 0 0.35rem;
    font-size: 1.04rem;
    font-weight: 600;
    color: #f1f5f9;
    letter-spacing: -0.015em;
  }

  .ep-sync {
    font-family: var(--font-mono);
    font-size: 0.77rem;
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .ep-src {
    opacity: 0.85;
  }

  .ep-src-ref {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #7c8798;
    margin-bottom: 0.35rem;
  }

  .ep-src pre {
    margin: 0;
    padding: 0.65rem 0.85rem;
    border-left: 2px solid #2c3545;
    background: rgba(13, 17, 24, 0.55);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.58;
    color: #94a3b8;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .ep-data-title {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #94a3b8;
    margin-bottom: 0.45rem;
  }

  .ep-data pre {
    margin: 0;
    padding: 0.9rem 1.05rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 3px;
    background: #0a0e15;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.62;
    color: #e2e8f0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  @media (max-width: 860px) {
    .ep-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>

<script>
  const root = document.getElementById('exec-path');
  if (root) {
    const nodes = Array.from(root.querySelectorAll('.ep-node'));
    const cols = Array.from(root.querySelectorAll('.col-bg'));
    const beams = Array.from(root.querySelectorAll('.flow-beam'));
    const asyncPulse = root.querySelector('.async-pulse');
    const panels = Array.from(root.querySelectorAll('.ep-row'));
    const counter = document.getElementById('ep-counter');
    const prevBtn = document.getElementById('ep-prev');
    const nextBtn = document.getElementById('ep-next');
    const playBtn = document.getElementById('ep-play');

    // Live SVG readout elements (shows concurrent asynchronous state updates)
    const elT1Px = document.getElementById('live-t1-px');
    const elT1Qty = document.getElementById('live-t1-qty');
    const elT1Id = document.getElementById('live-t1-id');
    const elT2Bba = document.getElementById('live-t2-bba');
    const elT2Side = document.getElementById('live-t2-side');
    const elT3Ratio = document.getElementById('live-t3-ratio');
    const elT3Cnt = document.getElementById('live-t3-cnt');
    const elT4Score = document.getElementById('live-t4-score');
    const elAtom = document.getElementById('live-atom');
    const elT5Act = document.getElementById('live-t5-act');

    // Representative asynchronous simulation frames:
    // Multiple ticks arrive in T1->T2->T3 while T4 (ONNX) and T5 (Strategy)
    // evaluate on their own cadence and only fire when score > 0.650f.
    const frames = [
      {
        t1Px: '"p":"100418.00"',
        t1Qty: '"q":"0.42" "m":true',
        t1Id: 't=5481920408',
        t2Bba: 'last  100418.00',
        t2Side: 'taker SELL $42.2k',
        t3Ratio: 'buy_ratio_5s  0.540',
        t3Cnt: 'trades_5s     11',
        t4Score: 'score  0.584f',
        atom: '0.584',
        t5Act: 'HOLD (< 0.650)',
      },
      {
        t1Px: '"p":"100419.50"',
        t1Qty: '"q":"0.90" "m":false',
        t1Id: 't=5481920409',
        t2Bba: 'last  100419.50',
        t2Side: 'taker BUY  $90.4k',
        t3Ratio: 'buy_ratio_5s  0.642',
        t3Cnt: 'trades_5s     12',
        t4Score: 'score  0.584f', // async: ONNX hasn't re-scored yet
        atom: '0.584',
        t5Act: 'HOLD (< 0.650)',
      },
      {
        t1Px: '"p":"100420.00"',
        t1Qty: '"q":"0.65" "m":false',
        t1Id: 't=5481920410',
        t2Bba: 'last  100420.00',
        t2Side: 'taker BUY  $65.3k',
        t3Ratio: 'buy_ratio_5s  0.710',
        t3Cnt: 'trades_5s     13',
        t4Score: 'score  0.641f',
        atom: '0.641',
        t5Act: 'HOLD (< 0.650)',
      },
      {
        t1Px: '"p":"100420.50"',
        t1Qty: '"q":"1.85" "m":false',
        t1Id: 't=5481920411',
        t2Bba: 'last  100420.50',
        t2Side: 'taker BUY $185.8k',
        t3Ratio: 'buy_ratio_5s  0.780',
        t3Cnt: 'trades_5s     14',
        t4Score: 'score  0.712f',
        atom: '0.712',
        t5Act: 'BUY 0.01 MARKET',
      },
      {
        t1Px: '"p":"100421.00"',
        t1Qty: '"q":"0.30" "m":false',
        t1Id: 't=5481920412',
        t2Bba: 'last  100421.00',
        t2Side: 'taker BUY  $30.1k',
        t3Ratio: 'buy_ratio_5s  0.794',
        t3Cnt: 'trades_5s     15',
        t4Score: 'score  0.712f',
        atom: '0.712',
        t5Act: 'ORDER SUBMITTED',
      },
    ];

    let current = 0;
    let frameIdx = 3; // start on the representative triggered frame
    let timer = null;

    function applyFrame(fi) {
      const f = frames[fi % frames.length];
      if (elT1Px) elT1Px.textContent = f.t1Px;
      if (elT1Qty) elT1Qty.textContent = f.t1Qty;
      if (elT1Id) elT1Id.textContent = f.t1Id;
      if (elT2Bba) elT2Bba.textContent = f.t2Bba;
      if (elT2Side) elT2Side.textContent = f.t2Side;
      if (elT3Ratio) elT3Ratio.textContent = f.t3Ratio;
      if (elT3Cnt) elT3Cnt.textContent = f.t3Cnt;
      if (elT4Score) elT4Score.textContent = f.t4Score;
      if (elAtom) elAtom.textContent = f.atom;
      if (elT5Act) elT5Act.textContent = f.t5Act;
    }

    function setStep(idx) {
      current = (idx + nodes.length) % nodes.length;
      root.dataset.step = String(current);
      if (counter) counter.textContent = `Stage ${current + 1} / ${nodes.length}`;

      cols.forEach((c, i) => c.classList.toggle('is-active', i === current));
      nodes.forEach((n, i) => n.classList.toggle('is-active', i === current));
      beams.forEach((b, i) => {
        b.classList.toggle('is-active', i === current - 1 || (current === 0 && i === 0));
      });
      asyncPulse?.classList.toggle('is-active', current >= 1);
      panels.forEach((p, i) => p.classList.toggle('is-active', i === current));
    }

    function stopAuto() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
      root.classList.add('is-paused');
      playBtn?.classList.remove('is-playing');
      if (playBtn) playBtn.textContent = 'Play';
    }

    function startAuto() {
      if (timer !== null) return;
      root.classList.remove('is-paused');
      playBtn?.classList.add('is-playing');
      if (playBtn) playBtn.textContent = 'Pause';
      timer = window.setInterval(() => {
        frameIdx = (frameIdx + 1) % frames.length;
        applyFrame(frameIdx);
        setStep(current + 1);
      }, 2200);
    }

    applyFrame(frameIdx);
    setStep(0);

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      stopAuto();
    } else {
      startAuto();
    }

    prevBtn?.addEventListener('click', () => {
      stopAuto();
      setStep(current - 1);
    });
    nextBtn?.addEventListener('click', () => {
      stopAuto();
      setStep(current + 1);
    });
    playBtn?.addEventListener('click', () => {
      if (timer !== null) stopAuto();
      else startAuto();
    });

    nodes.forEach((node, idx) => {
      node.addEventListener('click', () => {
        stopAuto();
        applyFrame(3); // pin representative triggered frame when inspecting
        setStep(idx);
      });
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          stopAuto();
          applyFrame(3);
          setStep(idx);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          stopAuto();
          setStep(idx + 1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          stopAuto();
          setStep(idx - 1);
        }
      });
    });
  }
</script>
