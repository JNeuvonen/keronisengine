---
const GH = 'https://github.com/JNeuvonen/keronisengine/blob/main';

const steps = [
  {
    idx: 0,
    col: 0,
    headline: 'MarketDataStreams parses raw wire JSON via simdjson & fans out',
    sync: 'DataRecorder · BarAggregator (OHLCV) · sm_queue_ · live_event_queue_',
    dataTitle: 'Raw Binance Futures Wire Frame (btcusdt@trade)',
    data: `{
  "e": "trade",
  "E": 1732632012418,
  "T": 1732632012416,
  "s": "BTCUSDT",
  "t": 5481920411,
  "p": "100420.50",
  "q": "1.85",
  "m": false
}`,
    links: [
      { label: 'normalized_trade.cpp:59', href: `${GH}/src/cpp/packages/market_data/src/normalized_trade.cpp#L59` },
      { label: 'market_data_streams.cpp:1423–1444', href: `${GH}/src/cpp/packages/market_data/src/market_data_streams.cpp#L1423-L1444` },
    ],
    code: `DataRecorder::getInstance().record_with_symbol(..., msg);
BarAggregator::getInstance().add_trade(trade, true);
StateMachineDispatcher::get_instance().enqueue(MarketEvent(ev));
live_event_callback_(std::move(ev));`,
  },
  {
    idx: 1,
    col: 1,
    headline: 'Dedicated SM thread updates your compiled C++ feature state',
    sync: 'Shared C++ code between offline feature generation and live trading',
    dataTitle: 'YourFeatureSM::emit_state() -> vector<float>',
    data: `// Plug in any StrategyStateMachine (out-of-tree via -DKERONIS_STRATEGY_DIRS)
emit_state() -> float[N] {
  your_feature_0:  0.780f,
  your_feature_1:  14.0f,
  your_feature_2:  0.412f,
  ...
  your_feature_n:  -0.195f
}`,
    links: [
      { label: 'state_machine_dispatcher.cpp:64', href: `${GH}/src/cpp/packages/market_data/src/state_machine_dispatcher.cpp#L64` },
      { label: 'strategy_state_machine.h', href: `${GH}/src/cpp/packages/market_data/include/market_data/strategy_state_machine.h` },
    ],
    code: `// Versioned local snapshot — no mutex on hot path
for (auto& sm : snapshot) {
    sm->react(event);
}`,
  },
  {
    idx: 2,
    col: 2,
    headline: 'Async worker pool reads features + OHLCV bars & scores ONNX',
    sync: 'In-flight guarded pool (hardware_concurrency) → atomic_signal_main',
    dataTitle: 'OnnxModel::predict() → AtomicSignal',
    data: `model:              "your_model.onnx" (in-process C++ session)
inputs:             sm->emit_state() + latest OhlcvDataset bars
predicted_score:    0.712f  (> 0.650f entry threshold)
atomic_signal_main: store(0.712f, 1732632012418)`,
    links: [
      { label: 'engine.cpp:728', href: `${GH}/src/cpp/packages/trading_engine/src/engine.cpp#L728` },
      { label: 'binance_onnx_perp.cpp:34', href: `${GH}/src/cpp/packages/strategies/binance_onnx_perp/binance_onnx_perp.cpp#L34` },
    ],
    code: `float score = model->predict(*features);
ticker->atomic_signal_main.store(score, now_ms);`,
  },
  {
    idx: 3,
    col: 3,
    headline: 'Strategy pool reads atomic signal, bars & books and checks risk',
    sync: 'ticker->trading_mutex → construct_order() (caps · rate · quote holds)',
    dataTitle: 'Risk Gate & Order Construction',
    data: `signal:      atomic_signal_main.load() == 0.712f
market_data: latest OhlcvDataset bars + live BBA / books
risk_gate:   trading_mutex · quotes_pulled=false · PASS
result:      OrderConstructionResult::VALID`,
    links: [
      { label: 'engine.cpp:871', href: `${GH}/src/cpp/packages/trading_engine/src/engine.cpp#L871` },
      { label: 'binance_onnx_perp.cpp:57', href: `${GH}/src/cpp/packages/strategies/binance_onnx_perp/binance_onnx_perp.cpp#L57` },
    ],
    code: `std::lock_guard lock(ticker->trading_mutex);
auto [score, ts] = ticker->atomic_signal_main.load();
StrategyHelpers::submit_market_order(..., decision);`,
  },
  {
    idx: 4,
    col: 4,
    headline: 'Validated order dispatches across the TradeTicker execution seam',
    sync: 'Direct signers · bundled cpp_live_proxy · PaperExchange · BacktestState',
    dataTitle: 'Core::Order Dispatched (<1 ms hot path)',
    data: `order:  { symbol: "BTCUSDT", side: BUY, type: MARKET, qty: "0.01" }
direct: Polymarket (EIP-712) · Hyperliquid (Rust) · Aster
proxy:  Binance · Bybit · OKX · Gate.io · IBKR Equities
sim:    PaperExchange (live depth) · BacktestState (Parquet)`,
    links: [
      { label: 'state_updater.cpp:4065', href: `${GH}/src/cpp/packages/live_infra/src/state_updater.cpp#L4065` },
      { label: 'paper_exchange.h', href: `${GH}/src/cpp/packages/live_infra/include/live_infra/paper_exchange.h` },
    ],
    code: `// Identical strategy binary across backtest, paper, and live
ticker->mark_order_to_be_created(engine, order, decision, strategy);`,
  },
];
---

<div class="ep" id="exec-path" data-step="0">
  <div class="ep-top">
    <div class="ep-legend" aria-label="Diagram key">
      <span><i class="dot dot-comp"></i>Active compute</span>
      <span><i class="dot dot-queue"></i>Lock-free queue</span>
      <span><i class="dot dot-atom"></i>Atomic register</span>
    </div>
    <div class="ep-ctrl">
      <span class="ep-step-num" id="ep-counter">Stage 1 / 5</span>
      <button type="button" class="ep-btn" id="ep-prev" aria-label="Previous stage">←</button>
      <button type="button" class="ep-btn" id="ep-next" aria-label="Next stage">→</button>
      <button type="button" class="ep-btn ep-play" id="ep-play">Pause</button>
    </div>
  </div>

  <!-- Open 5-column vertical thread-swimlane illustration (2 lines max per box) -->
  <div class="ep-stage">
    <svg
      viewBox="0 0 1180 356"
      role="img"
      aria-label="Vertical thread swimlane visualization showing raw Binance trade ticks fanning out to BarAggregator, DataRecorder, live_event_consumer, and directly into StateMachineDispatcher, with OHLCV bars and books feeding both predictions_pool and strategy_pool"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <marker id="arr-muted" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#64748b" />
        </marker>
        <marker id="arr-queue" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#60a5fa" />
        </marker>
        <marker id="arr-atom" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 1 L8 4 L0 7 z" fill="#d4a359" />
        </marker>
      </defs>

      <!-- 5 Vertical Thread Swimlane Backgrounds -->
      <rect class="col-bg" data-col="0" x="0" y="0" width="206" height="308" fill="transparent" />
      <rect class="col-bg" data-col="1" x="242" y="0" width="206" height="308" fill="transparent" />
      <rect class="col-bg" data-col="2" x="484" y="0" width="206" height="308" fill="transparent" />
      <rect class="col-bg" data-col="3" x="726" y="0" width="206" height="308" fill="transparent" />
      <rect class="col-bg" data-col="4" x="968" y="0" width="212" height="308" fill="transparent" />

      <!-- Vertical thread boundary hairlines -->
      <line x1="224" y1="8" x2="224" y2="306" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="466" y1="8" x2="466" y2="306" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="708" y1="8" x2="708" y2="306" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />
      <line x1="950" y1="8" x2="950" y2="306" stroke="#1b222e" stroke-width="1" stroke-dasharray="3 4" />

      <!-- Thread Column Headers -->
      <text x="14" y="24" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T1 · MarketDataStreams</text>
      <text x="14" y="40" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">WS I/O + simdjson</text>

      <text x="256" y="24" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T2 · Feature SM</text>
      <text x="256" y="40" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">StateMachineDispatcher</text>

      <text x="498" y="24" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T3 · ONNX Pool</text>
      <text x="498" y="40" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">predictions_pool (async)</text>

      <text x="740" y="24" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T4 · Strategy Pool</text>
      <text x="740" y="40" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">strategy_pool (async)</text>

      <text x="982" y="24" fill="#e2e8f0" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600">T5 · Execution Seam</text>
      <text x="982" y="40" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="10">Core::TradeTicker</text>

      <!-- CONCURRENT UPPER FAN-OUT: T1 -> BarAggregator (OhlcvDataset) / DataRecorder / live_event_consumer -> T3 & T4 -->
      <path d="M 103 156 L 103 94 L 256 94" fill="none" stroke="#222c3c" stroke-width="1.4" />
      <path class="async-pulse" d="M 103 156 L 103 94 L 256 94" fill="none" stroke="#60a5fa" stroke-width="1.6" marker-end="url(#arr-queue)" />

      <!-- Concurrent state bar spanning T2..T3 -->
      <rect x="256" y="72" width="420" height="44" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.16)" stroke-width="1.1" />
      <text x="272" y="91" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600">
        BarAggregator (OhlcvDataset) · DataRecorder · live_event_consumer
      </text>
      <text id="live-bar" x="272" y="107" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">
        1m bar close 100420.50 · live BBA &amp; books · PaperExchange prints
      </text>

      <!-- Tap 1: OHLCV bars & books -> T3 predictions_pool (compute_predictions_callback) -->
      <path d="M 587 116 L 587 152" fill="none" stroke="#222c3c" stroke-width="1.4" />
      <path class="async-pulse" d="M 587 116 L 587 152" fill="none" stroke="#94a3b8" stroke-width="1.6" marker-end="url(#arr-muted)" />

      <!-- Tap 2: OHLCV bars & books -> T4 strategy_pool (strategy_callback) -->
      <path d="M 676 94 L 829 94 L 829 152" fill="none" stroke="#222c3c" stroke-width="1.4" />
      <path class="async-pulse" d="M 676 94 L 829 94 L 829 152" fill="none" stroke="#94a3b8" stroke-width="1.6" marker-end="url(#arr-muted)" />

      <!-- MAIN LEFT-TO-RIGHT HANDOFFS -->
      <!-- Handoff 0->1: sm_queue_ with animated 3-slot ring buffer -->
      <line x1="192" y1="192" x2="254" y2="192" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-queue)" />
      <line class="flow-beam" data-beam="0" x1="192" y1="192" x2="250" y2="192" stroke="#60a5fa" stroke-width="2" />
      <g class="q-glyph" transform="translate(206, 182)">
        <rect x="0" y="0" width="36" height="20" rx="2" fill="#0b1220" stroke="#60a5fa" stroke-opacity="0.7" stroke-width="1.2" />
        <rect id="q-s0" x="4" y="4" width="7" height="12" rx="1" fill="#60a5fa" />
        <rect id="q-s1" x="14" y="4" width="7" height="12" rx="1" fill="#60a5fa" opacity="0.5" />
        <rect id="q-s2" x="24" y="4" width="7" height="12" rx="1" fill="#1e293b" />
      </g>
      <text x="224" y="256" text-anchor="middle" fill="#60a5fa" font-family="IBM Plex Mono, monospace" font-size="10.5">sm_queue_</text>
      <text x="224" y="271" text-anchor="middle" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">lock-free MPSC</text>

      <!-- Handoff 1->2: emit_state() -->
      <line x1="434" y1="192" x2="496" y2="192" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-muted)" />
      <line class="flow-beam" data-beam="1" x1="434" y1="192" x2="492" y2="192" stroke="#cbd5e1" stroke-width="2" />
      <text x="466" y="256" text-anchor="middle" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">emit_state()</text>
      <text x="466" y="271" text-anchor="middle" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">float[N]</text>

      <!-- Handoff 2->3: atomic_signal_main -->
      <line x1="676" y1="192" x2="738" y2="192" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-atom)" />
      <line class="flow-beam" data-beam="2" x1="676" y1="192" x2="734" y2="192" stroke="#d4a359" stroke-width="2.2" />
      <g class="atom-glyph" transform="translate(683, 179)">
        <rect x="0" y="0" width="50" height="26" rx="2" fill="#15120b" stroke="#d4a359" stroke-width="1.3" />
        <text id="live-atom" x="25" y="17" text-anchor="middle" fill="#f3d092" font-family="IBM Plex Mono, monospace" font-size="10" font-weight="600">0.712</text>
      </g>
      <text x="708" y="256" text-anchor="middle" fill="#d4a359" font-family="IBM Plex Mono, monospace" font-size="10.5">atomic_signal</text>
      <text x="708" y="271" text-anchor="middle" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">store / load</text>

      <!-- Handoff 3->4: TradeTicker seam -->
      <line x1="918" y1="192" x2="980" y2="192" stroke="#283446" stroke-width="1.6" marker-end="url(#arr-muted)" />
      <line class="flow-beam" data-beam="3" x1="918" y1="192" x2="976" y2="192" stroke="#cbd5e1" stroke-width="2" />
      <text x="950" y="256" text-anchor="middle" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">Core::Order</text>
      <text x="950" y="271" text-anchor="middle" fill="#8b96a8" font-family="IBM Plex Mono, monospace" font-size="9.5">risk-checked</text>

      <!-- 5 COMPACT STAGE NODES — STRICTLY 2 LINES PER BOX -->
      <g class="ep-node is-active" data-node="0" role="button" tabindex="0" aria-label="Stage 1: Raw Trade ingest">
        <rect x="14" y="156" width="178" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="28" y="185" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">Raw Trade</text>
        <text id="live-t1" x="28" y="209" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">100420.50 · 1.85 BUY</text>
      </g>

      <g class="ep-node" data-node="1" role="button" tabindex="0" aria-label="Stage 2: User-defined Feature SM">
        <rect x="256" y="156" width="178" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="270" y="185" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">Feature SM</text>
        <text id="live-t2" x="270" y="209" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">float[N] updated</text>
      </g>

      <g class="ep-node" data-node="2" role="button" tabindex="0" aria-label="Stage 3: ONNX Model Inference">
        <rect x="498" y="156" width="178" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="512" y="185" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">ONNX Model</text>
        <text id="live-t3" x="512" y="209" fill="#f3d092" font-family="IBM Plex Mono, monospace" font-size="10.5">score 0.712</text>
      </g>

      <g class="ep-node" data-node="3" role="button" tabindex="0" aria-label="Stage 4: Strategy and Risk Gate">
        <rect x="740" y="156" width="178" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="754" y="185" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">Strategy &amp; Risk</text>
        <text id="live-t4" x="754" y="209" fill="#cbd5e1" font-family="IBM Plex Mono, monospace" font-size="10.5">BUY 0.01 MARKET</text>
      </g>

      <g class="ep-node" data-node="4" role="button" tabindex="0" aria-label="Stage 5: Venue Dispatch">
        <rect x="982" y="156" width="184" height="72" rx="3" fill="#0b0f16" stroke="rgba(148,163,184,0.14)" stroke-width="1.2" />
        <text x="996" y="185" fill="#f1f5f9" font-family="Inter, sans-serif" font-size="14" font-weight="600">Venue Dispatch</text>
        <text id="live-t5" x="996" y="209" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">Direct · Proxy · Paper</text>
      </g>

      <!-- Bottom bracket -->
      <path d="M 14 306 L 14 318 L 1166 318 L 1166 306" fill="none" stroke="#222c3c" stroke-width="1.2" />
      <text x="590" y="340" text-anchor="middle" fill="#94a3b8" font-family="IBM Plex Mono, monospace" font-size="10.5">
        &lt;1 ms tick → features → inference → order · T3 (ONNX) and T4 (Strategy) read latest bars, books &amp; features asynchronously
      </text>
    </svg>
  </div>

  <!-- Quiet, low-chrome data & source inspector with clickable GitHub links -->
  <div class="ep-inspector">
    {steps.map((s) => (
      <div class={`ep-row ${s.idx === 0 ? 'is-active' : ''}`} data-panel={s.idx}>
        <div class="ep-summary">
          <h3>{s.headline}</h3>
          <div class="ep-sync">{s.sync}</div>
          <div class="ep-src">
            <div class="ep-src-links">
              {s.links.map((lnk, li) => (
                <>
                  {li > 0 && <span class="ep-sep">·</span>}
                  <a href={lnk.href} target="_blank" rel="noopener noreferrer">{lnk.label} ↗</a>
                </>
              ))}
            </div>
            <pre><code>{s.code}</code></pre>
          </div>
        </div>
        <div class="ep-data">
          <div class="ep-data-title">{s.dataTitle}</div>
          <pre><code>{s.data}</code></pre>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .ep {
    margin-top: 0.5rem;
  }

  .ep-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
  }

  .ep-legend {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .ep-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-comp {
    background: #f1f5f9;
  }

  .dot-queue {
    background: #60a5fa;
  }

  .dot-atom {
    background: #d4a359;
  }

  .ep-ctrl {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .ep-step-num {
    color: #8b96a8;
    margin-right: 0.4rem;
  }

  .ep-btn {
    appearance: none;
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #cbd5e1;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.24rem 0.6rem;
    border-radius: 3px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .ep-btn:hover {
    border-color: #94a3b8;
    color: #ffffff;
  }

  .ep-btn:focus-visible,
  .ep-node:focus-visible {
    outline: 2px solid #f1f5f9;
    outline-offset: 2px;
  }

  .ep-play.is-playing {
    border-color: rgba(212, 163, 89, 0.65);
    color: #f3d092;
  }

  .ep-stage {
    padding: 1.2rem 0 0.4rem;
    overflow-x: auto;
  }

  .ep-stage svg {
    display: block;
    width: 100%;
    min-width: 860px;
    height: auto;
  }

  .col-bg {
    transition: fill 0.22s ease;
  }

  .col-bg.is-active {
    fill: rgba(241, 245, 249, 0.028);
  }

  .ep-node {
    cursor: pointer;
  }

  .ep-node rect {
    transition: stroke 0.2s ease, fill 0.2s ease;
  }

  .ep-node:hover rect {
    stroke: rgba(148, 163, 184, 0.45);
  }

  .ep-node.is-active rect {
    stroke: #f1f5f9;
    fill: #111722;
    stroke-width: 1.6;
  }

  .async-pulse,
  .flow-beam {
    stroke-dasharray: 6 12;
    opacity: 0.22;
    transition: opacity 0.2s ease;
  }

  .flow-beam.is-active {
    opacity: 0.95;
  }

  .async-pulse.is-active {
    opacity: 0.78;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ep:not(.is-paused) .async-pulse {
      animation: epFlow 2.3s linear infinite;
    }
    .ep:not(.is-paused) .flow-beam.is-active {
      animation: epFlow 0.95s linear infinite;
    }
  }

  @keyframes epFlow {
    from {
      stroke-dashoffset: 36;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .ep-inspector {
    margin-top: 0.6rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(148, 163, 184, 0.14);
  }

  .ep-row {
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    gap: 2.25rem;
    align-items: start;
  }

  .ep-row.is-active {
    display: grid;
  }

  .ep-summary h3 {
    margin: 0 0 0.35rem;
    font-size: 1.04rem;
    font-weight: 600;
    color: #f1f5f9;
    letter-spacing: -0.015em;
  }

  .ep-sync {
    font-family: var(--font-mono);
    font-size: 0.77rem;
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .ep-src-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.73rem;
    margin-bottom: 0.4rem;
  }

  .ep-src-links a {
    color: #94a3b8;
    text-decoration: underline;
    text-decoration-color: rgba(148, 163, 184, 0.35);
    text-underline-offset: 2px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .ep-src-links a:hover {
    color: #f1f5f9;
    text-decoration-color: #f1f5f9;
  }

  .ep-sep {
    color: #475569;
  }

  .ep-src pre {
    margin: 0;
    padding: 0.65rem 0.85rem;
    border-left: 2px solid #2c3545;
    background: rgba(13, 17, 24, 0.55);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.58;
    color: #94a3b8;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .ep-data-title {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #94a3b8;
    margin-bottom: 0.45rem;
  }

  .ep-data pre {
    margin: 0;
    padding: 0.9rem 1.05rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 3px;
    background: #0a0e15;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.62;
    color: #e2e8f0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  @media (max-width: 860px) {
    .ep-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>

<script>
  const root = document.getElementById('exec-path');
  if (root) {
    const nodes = Array.from(root.querySelectorAll('.ep-node'));
    const cols = Array.from(root.querySelectorAll('.col-bg'));
    const beams = Array.from(root.querySelectorAll('.flow-beam'));
    const asyncPulses = Array.from(root.querySelectorAll('.async-pulse'));
    const panels = Array.from(root.querySelectorAll('.ep-row'));
    const counter = document.getElementById('ep-counter');
    const prevBtn = document.getElementById('ep-prev');
    const nextBtn = document.getElementById('ep-next');
    const playBtn = document.getElementById('ep-play');

    const elT1 = document.getElementById('live-t1');
    const elT2 = document.getElementById('live-t2');
    const elT3 = document.getElementById('live-t3');
    const elAtom = document.getElementById('live-atom');
    const elT4 = document.getElementById('live-t4');
    const elT5 = document.getElementById('live-t5');
    const elBar = document.getElementById('live-bar');
    const qSlots = [
      document.getElementById('q-s0'),
      document.getElementById('q-s1'),
      document.getElementById('q-s2'),
    ];

    const frames = [
      {
        t1: '100418.00 · 0.42 SELL',
        t2: 'float[N] seq #408',
        t3: 'score 0.584',
        atom: '0.584',
        t4: 'HOLD (< 0.650)',
        t5: 'idle',
        bar: '1m bar close 100418.00 · live BBA & books · PaperExchange prints',
        qDepth: 1,
      },
      {
        t1: '100419.50 · 0.90 BUY',
        t2: 'float[N] seq #409',
        t3: 'score 0.584', // async: ONNX has not re-scored on this tick
        atom: '0.584',
        t4: 'HOLD (< 0.650)',
        t5: 'idle',
        bar: '1m bar close 100419.50 · live BBA & books · PaperExchange prints',
        qDepth: 2,
      },
      {
        t1: '100420.00 · 0.65 BUY',
        t2: 'float[N] seq #410',
        t3: 'score 0.641',
        atom: '0.641',
        t4: 'HOLD (< 0.650)',
        t5: 'idle',
        bar: '1m bar close 100420.00 · live BBA & books · PaperExchange prints',
        qDepth: 3,
      },
      {
        t1: '100420.50 · 1.85 BUY',
        t2: 'float[N] seq #411',
        t3: 'score 0.712',
        atom: '0.712',
        t4: 'BUY 0.01 MARKET',
        t5: 'Direct · Proxy · Paper',
        bar: '1m bar close 100420.50 · live BBA & books · PaperExchange prints',
        qDepth: 2,
      },
      {
        t1: '100421.00 · 0.30 BUY',
        t2: 'float[N] seq #412',
        t3: 'score 0.712',
        atom: '0.712',
        t4: 'ORDER VALID',
        t5: 'SUBMITTED',
        bar: '1m bar close 100421.00 · live BBA & books · PaperExchange prints',
        qDepth: 1,
      },
    ];

    let current = 0;
    let frameIdx = 3;
    let timer = null;

    function applyFrame(fi) {
      const f = frames[fi % frames.length];
      if (elT1) elT1.textContent = f.t1;
      if (elT2) elT2.textContent = f.t2;
      if (elT3) elT3.textContent = f.t3;
      if (elAtom) elAtom.textContent = f.atom;
      if (elT4) elT4.textContent = f.t4;
      if (elT5) elT5.textContent = f.t5;
      if (elBar) elBar.textContent = f.bar;
      qSlots.forEach((slot, i) => {
        if (!slot) return;
        const filled = i < f.qDepth;
        slot.setAttribute('fill', filled ? '#60a5fa' : '#1e293b');
        slot.setAttribute('opacity', filled ? (i === 0 ? '1' : '0.65') : '1');
      });
    }

    function setStep(idx) {
      current = (idx + nodes.length) % nodes.length;
      root.dataset.step = String(current);
      if (counter) counter.textContent = `Stage ${current + 1} / ${nodes.length}`;

      cols.forEach((c, i) => c.classList.toggle('is-active', i === current));
      nodes.forEach((n, i) => n.classList.toggle('is-active', i === current));
      beams.forEach((b, i) => {
        b.classList.toggle('is-active', i === current - 1 || (current === 0 && i === 0));
      });
      asyncPulses.forEach((p) => {
        p.classList.toggle('is-active', current === 0 || current === 2 || current === 3);
      });
      panels.forEach((p, i) => p.classList.toggle('is-active', i === current));
    }

    function stopAuto() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
      root.classList.add('is-paused');
      playBtn?.classList.remove('is-playing');
      if (playBtn) playBtn.textContent = 'Play';
    }

    function startAuto() {
      if (timer !== null) return;
      root.classList.remove('is-paused');
      playBtn?.classList.add('is-playing');
      if (playBtn) playBtn.textContent = 'Pause';
      timer = window.setInterval(() => {
        frameIdx = (frameIdx + 1) % frames.length;
        applyFrame(frameIdx);
        setStep(current + 1);
      }, 2200);
    }

    applyFrame(frameIdx);
    setStep(0);

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      stopAuto();
    } else {
      startAuto();
    }

    prevBtn?.addEventListener('click', () => {
      stopAuto();
      setStep(current - 1);
    });
    nextBtn?.addEventListener('click', () => {
      stopAuto();
      setStep(current + 1);
    });
    playBtn?.addEventListener('click', () => {
      if (timer !== null) stopAuto();
      else startAuto();
    });

    nodes.forEach((node, idx) => {
      node.addEventListener('click', () => {
        stopAuto();
        applyFrame(3);
        setStep(idx);
      });
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          stopAuto();
          applyFrame(3);
          setStep(idx);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          stopAuto();
          setStep(idx + 1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          stopAuto();
          setStep(idx - 1);
        }
      });
    });
  }
</script>
